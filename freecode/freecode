PREFS_LOG = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "freecode", "prefs-history.jsonl")


def save_prefs(chosen, source):
    """Writes the PREFS block in AGENTS.md and appends the change to the history (for --undo)."""
    text = open(AGENTS_FILE, encoding="utf-8").read() if os.path.isfile(AGENTS_FILE) else ""
    before = current_prefs(text)
    full = {k: chosen.get(k) or before.get(k) or d for k, _, _, d in PREFS}
    lines = ["## Work Preferences (chosen by the user: `freecode --configure`; these override other sections)"]
    lines += [f"<!-- pref {k}={full[k]} -->\n- {ans[full[k]]}" for k, _, ans, _ in PREFS]
    write_block(PREFS_START, PREFS_END, "\n".join(lines), before="## Show Your Work")
    if full != before:
        os.makedirs(os.path.dirname(PREFS_LOG), exist_ok=True)
        with open(PREFS_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps({"time": time.strftime("%Y-%m-%d %H:%M:%S"), "source": source,
                                "before": before, "after": full}) + "\n")
    info(color(32, "  work style: " + ", ".join(f"{k}={v}" for k, v in full.items())
                   + ("" if full != before else " (unchanged)")))
    return full


def stage_prefs():
    """Stage 3: the model's work style — a/b/c questions, Enter = current choice."""
    info("freecode — stage 3: the model's work style (Enter = current choice)")
    prev = current_prefs(open(AGENTS_FILE, encoding="utf-8").read() if os.path.isfile(AGENTS_FILE) else "")
    chosen = {}
    for key, question, answers, default in PREFS:
        info(f"  {question}")
        for letter, rule in answers.items():
