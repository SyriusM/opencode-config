        a = tty_input("Choice (a/b/c)", prev.get(key, default)).lower()[:1]
        chosen[key] = a if a in answers else prev.get(key, default)
    save_prefs(chosen, "configure")
    return 0


def set_prefs(args):
    """`--set key=letter ...` — no questions (e.g. the model after a bad rating, with the user's consent)."""
    valid = {k: ans for k, _, ans, _ in PREFS}
    chosen = {}
    for a in args:
        k, _, v = a.partition("=")
        if k not in valid or v not in valid[k]:
            info(color(31, f"  bad argument {a!r} — possible: " + ", ".join(f"{k}={'/'.join(v)}" for k, v in valid.items())))
            return 1
        chosen[k] = v
    if not chosen:
        info("  give e.g.: freecode --set narration=b"); return 1
    save_prefs(chosen, "set")
    info(color(2, "  undo: freecode --undo"))
    return 0


def undo_prefs():
