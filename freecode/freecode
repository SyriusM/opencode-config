OLD_MARKER = os.path.join(FC_DIR, "skonfigurowane")  # before 2026-10-21
ENV_STAMP = os.path.join(FC_DIR, "env-checked")     # kiedy ostatnio sprawdzono opis komputera
AUDIT_LOG = os.path.join(FC_DIR, "audit.log")       # start refusals: JSON, one line per event
CONFIG_NAMES = ("opencode.jsonc", "opencode.json", "config.json")
# standard ports of local model servers
SERVERS = [("llama.cpp", 8080), ("Ollama", 11434), ("LM Studio", 1234), ("vLLM", 8000)]


def color(k, s):
    return f"\033[{k}m{s}\033[0m" if sys.stderr.isatty() else s


def info(s):
    print(s, file=sys.stderr)


# ── JSONC: // and /* */ comments and trailing commas, outside strings ──────────────────────
def jsonc(text):
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1]); i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True; out.append(c)
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        else:
            out.append(c)
        i += 1
    s = "".join(out)
    # a comma before } or ] (outside strings — strings no longer contain comments, but may contain ",}")
    result, in_str, i = [], False, 0
    while i < len(s):
        c = s[i]
        if in_str:
            result.append(c)
            if c == "\\" and i + 1 < len(s):
                result.append(s[i + 1]); i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True; result.append(c)
        elif c == ",":
            j = i + 1
            while j < len(s) and s[j] in " \t\r\n":
                j += 1
            if j >= len(s) or s[j] not in "}]":
                result.append(c)
        else:
            result.append(c)
        i += 1
    return json.loads("".join(result))


# ── configuration sources, in the order they are layered ─────────────────────────────────────────────
def sources(directory):
    paths = [os.path.join(OC_DIR, n) for n in CONFIG_NAMES]
    if os.environ.get("OPENCODE_CONFIG"):
        paths.append(os.environ["OPENCODE_CONFIG"])
    if not os.environ.get("OPENCODE_DISABLE_PROJECT_CONFIG"):
        # project files: from the start directory up to the git repository root (or the home directory)
        project, d = [], os.path.abspath(directory)
        while True:
            for n in ("opencode.jsonc", "opencode.json", ".opencode/opencode.jsonc", ".opencode/opencode.json"):
                p = os.path.join(d, n)
                if os.path.abspath(os.path.dirname(p)) != os.path.abspath(OC_DIR):
                    project.append(p)
            if os.path.exists(os.path.join(d, ".git")) or d in (HOME, "/"):
                break
            d = os.path.dirname(d)
        paths += reversed(project)
    files = [(p, None) for p in paths if os.path.isfile(p)]
    if os.environ.get("OPENCODE_CONFIG_CONTENT"):
        files.append(("$OPENCODE_CONFIG_CONTENT", os.environ["OPENCODE_CONFIG_CONTENT"]))
    return files


def is_local(url):
    try:
        host = urllib.parse.urlparse(url).hostname or ""
    except ValueError:
        return False
    hosts = os.environ.get("FREECODE_HOSTS") or os.environ.get("FREECODE_HOSTY") or ""
    extra = [h.strip() for h in hosts.split(",") if h.strip()]
    if host == "localhost" or host in extra:
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def provider_of(model):
    return model.split("/", 1)[0] if isinstance(model, str) and "/" in model else None


def check(directory="."):
    """Returns (problems, merged configuration, main file). An empty problem list = OK to start."""
    problems, merged, providers = [], {}, {}
    files = sources(directory)
    if not files:
        return ["no opencode configuration (run: freecode --configure)"], {}, None
    for file_path, content in files:
        try:
            c = jsonc(content if content is not None else open(file_path, encoding="utf-8").read())
            if not isinstance(c, dict):
                raise ValueError("not a JSON object")
        except (ValueError, OSError) as e:
            problems.append(f"{file_path}: cannot be read ({e})")
            continue
        for k, v in c.items():
            if k == "provider" and isinstance(v, dict):
                for pid, p in v.items():
                    providers.setdefault(pid, {}).update(p if isinstance(p, dict) else {})
            elif k in ("agent", "mcp") and isinstance(v, dict):
                for a, cfg in v.items():
                    merged.setdefault(k, {}).setdefault(a, {}).update(cfg if isinstance(cfg, dict) else {})
            else:
                merged[k] = v
    if problems:
        return problems, merged, files[0][0]
    merged["provider"] = providers

    enabled = merged.get("enabled_providers")
    if not isinstance(enabled, list) or not enabled:
        problems.append("no `enabled_providers` — without this list opencode may use cloud providers")
        enabled = []
    for pid in enabled:
        url = ((providers.get(pid) or {}).get("options") or {}).get("baseURL")
        if not url:
            problems.append(f"provider `{pid}` has no `options.baseURL` — cannot tell whether it is local")
        elif not is_local(url):
            problems.append(f"provider `{pid}` is not local ({url}); allowed: localhost, 127.0.0.0/8, ::1, FREECODE_HOSTS")
        prov = providers.get(pid) or {}
        overrides = [(f"provider.{pid}.api", prov.get("api"))]   # the address may be overridden outside options.baseURL
        for mid, m in (prov.get("models") or {}).items() if isinstance(prov.get("models"), dict) else ():
            if isinstance(m, dict):
                overrides.append((f"provider.{pid}.models.{mid}.provider.api", (m.get("provider") or {}).get("api")
                                  if isinstance(m.get("provider"), dict) else None))
                overrides.append((f"provider.{pid}.models.{mid}.options.baseURL", (m.get("options") or {}).get("baseURL")
                                  if isinstance(m.get("options"), dict) else None))
        for name, u in overrides:
            if isinstance(u, str) and "://" in u and not is_local(u):
                problems.append(f"`{name}` = {u}: the address is not local")
    models = [("model", merged.get("model")), ("small_model", merged.get("small_model"))]
    models += [(f"agent.{a}.model", cfg.get("model")) for a, cfg in (merged.get("agent") or {}).items() if cfg.get("model")]
    for name, m in models:
        if not m:
            problems.append(f"no `{name}` — opencode will pick a model itself, possibly from the cloud"
                            + (" (small_model is used e.g. for session titles)" if name == "small_model" else ""))
        elif provider_of(m) not in enabled:
            problems.append(f"`{name}` = {m}: provider outside `enabled_providers`")
        else:
            models_map = (providers.get(provider_of(m)) or {}).get("models")
            if isinstance(models_map, dict) and m.split("/", 1)[1] not in models_map:
                problems.append(f"`{name}` = {m}: model `{m.split('/', 1)[1]}` does not exist in `provider.{provider_of(m)}.models`")
    # other ways session content leaves the computer
    if merged.get("share") == "auto" or merged.get("autoshare") is True:
        problems.append("`share` = auto — sessions would be shared on the internet automatically (set \"disabled\" or \"manual\")")
    ent = (merged.get("enterprise") or {}).get("url") if isinstance(merged.get("enterprise"), dict) else None
    if isinstance(ent, str) and ent and not is_local(ent):
        problems.append(f"`enterprise.url` = {ent}: the address is not local")
    for name, m in (merged.get("mcp") or {}).items() if isinstance(merged.get("mcp"), dict) else ():
        if m.get("type") == "remote" and m.get("enabled") is not False and not is_local(str(m.get("url") or "")):
            problems.append(f"MCP `{name}` server is remote ({m.get('url')}); disable it (\"enabled\": false) "
                            "or add the host to FREECODE_HOSTS")
    # plugins: local paths are OK, an npm package means a download from the network
    plugin_entries = merged.get("plugin")
    if isinstance(plugin_entries, list):
        allowed = [n.strip() for n in os.environ.get("FREECODE_PLUGINS", "").split(",") if n.strip()]
        for p in plugin_entries:
            if not isinstance(p, str) or p.startswith(("/", "./", "../", "~", "file://")):
                continue
            at = p.rfind("@")
            pkg = p[:at] if at > 0 else p
            if pkg in allowed:
                continue
            problems.append(f"plugin `{p}` is from npm (downloaded from the network); add it to FREECODE_PLUGINS or remove it from `plugin`")
    return problems, merged, files[0][0]


# ── konfigurator ─────────────────────────────────────────────────────────────────────────────
def tty_input(question, default=""):
    if os.environ.get("FREECODE_YES") or os.environ.get("FREECODE_TAK") or not os.path.exists("/dev/tty"):
        return default
    try:
        with open("/dev/tty", "r+") as t:
            t.write(f"  {question} [{default}]: "); t.flush()
            answer = t.readline().strip()
    except OSError:
        return default
    return answer or default


def server_models(url):
    try:
        with urllib.request.urlopen(url.rstrip("/") + "/models", timeout=3) as r:
            d = json.load(r)
        return [m.get("id") for m in d.get("data", []) if m.get("id")]
    except (OSError, ValueError):
        return None


def save(file_path, data):
    os.makedirs(os.path.dirname(file_path), exist_ok=True)
    if os.path.exists(file_path):
        backup = f"{file_path}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(file_path, backup)
        info(f"  backup: {backup}")
    tmp = file_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, file_path)
    info(color(32, f"  saved {file_path}"))


def mark_configured():
    os.makedirs(FC_DIR, exist_ok=True)
    with open(MARKER, "w") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S\n"))


ENV_START, ENV_END = "<!-- ENV:START -->", "<!-- ENV:END -->"
AGENTS_FILE = os.path.join(OC_DIR, "AGENTS.md")
THINKING_BUDGETS = {"low": 512, "medium": 2048, "high": 4096}  # thinking tokens per request (2026-10-25)

AGENT_PROMPTS = {  # agent → (mode, editing allowed); prompt = prompts/<agent>.txt if it exists
    "general": ("primary", True), "coder": ("primary", True),
    "reasoner": ("primary", False), "reviewer": ("subagent", False),
}


def run_out(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def server_ctx(url):
    """Context per conversation from llama.cpp /props (n_ctx divided by slots); None for other servers."""
    base = url.rstrip("/").removesuffix("/v1")
    try:
        with urllib.request.urlopen(base + "/props", timeout=5) as r:
            d = json.load(r)
        return int(d["default_generation_settings"]["n_ctx"]) // max(1, int(d.get("total_slots") or 1))
    except (OSError, ValueError, KeyError, TypeError):
        return None


def global_config():
    """Path of the global opencode.json(c) or None."""
    return next((os.path.join(OC_DIR, n) for n in CONFIG_NAMES if os.path.isfile(os.path.join(OC_DIR, n))), None)


def current_server():
    """(baseURL, model) from the current config: model → provider → options.baseURL."""
    f = global_config()
    try:
        c = jsonc(open(f, encoding="utf-8").read()) if f else {}
    except ValueError:
        return None, None
    pid, _, model = (c.get("model") or "").partition("/")
    url = (((c.get("provider") or {}).get(pid) or {}).get("options") or {}).get("baseURL")
    return url, model or None


def env_facts(url, model):
    """Facts about this computer for the model — so it neither asks nor guesses."""
    osr = {}
    try:
        for line in open("/etc/os-release", encoding="utf-8"):
            k, _, v = line.strip().partition("=")
            osr[k] = v.strip('"')
    except OSError:
        pass
    pkg = next((m for m in ("pacman", "apt", "dnf", "zypper", "apk", "brew") if shutil.which(m)), "?")
    cpu = next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "?") \
        if os.path.exists("/proc/cpuinfo") else "?"
    ram = next((int(l.split()[1]) // 1048576 for l in open("/proc/meminfo") if l.startswith("MemTotal")), 0) \
        if os.path.exists("/proc/meminfo") else 0
    gpu = run_out(["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"]) if shutil.which("nvidia-smi") else ""
    if not gpu and shutil.which("lspci"):
        gpu = "; ".join(l.split(": ", 1)[-1] for l in run_out(["lspci"]).splitlines()
                        if any(k in l for k in ("VGA", "3D controller", "Display controller")))
    desktop = " ".join(x for x in (os.environ.get("XDG_CURRENT_DESKTOP"), os.environ.get("XDG_SESSION_TYPE")) if x)
    ctx = server_ctx(url) if url else None
    try:  # login shell from passwd — $SHELL is sometimes overridden by the terminal or a tool
        login_shell = os.path.basename(pwd.getpwuid(os.getuid()).pw_shell)
    except (KeyError, OSError):
        login_shell = os.path.basename(os.environ.get("SHELL") or "?")
    lines = [
        f"- OS: {osr.get('PRETTY_NAME') or os.uname().sysname} ({os.uname().release}), packages: `{pkg}`" +
        (" — never apt" if pkg == "pacman" else ""),
        f"- User shell: `{login_shell}` (tool commands: simple POSIX, one per call), home `{HOME}`",
        f"- Desktop: {desktop or 'none / unknown'}",
        f"- CPU: {cpu}, {os.cpu_count()} threads; RAM {ram} GB",
        f"- GPU: {gpu or 'none detected'}",
        f"- Model: `{model or '?'}` at {url or '?'}" + (f", context {ctx} tokens — keep reads short" if ctx else "")
        + " (default model; an agent may run on another — check your own model, not this line)",
        "- Model runs locally: heavy GPU/RAM jobs (games, training, other models) slow it down or kill it.",
    ]
    return "## Environment (auto: `freecode --env`, " + time.strftime("%Y-%m-%d") + ")\n" + "\n".join(lines)


def current_env():
    """The current ENV block from AGENTS.md (without markers) or ""."""
    try:
        text = open(AGENTS_FILE, encoding="utf-8").read()
    except OSError:
        return ""
    if ENV_START not in text or ENV_END not in text:
        return ""
    return text.split(ENV_START, 1)[1].split(ENV_END, 1)[0].strip("\n")


def write_env(url=None, model=None):
    """Writes/refreshes the ENV block in AGENTS.md; leaves the rest of the file alone.

    Writes only when the facts changed (the date in the header alone does not count): every write changes
    the mtime of AGENTS.md, which restarts the background service and invalidates the prompt cache. Returns True after a write.
    """
    if not url:
        url, model = current_server()
    new, old = env_facts(url, model), current_env()
    line = next((l for l in new.splitlines() if l.startswith("- Model:")), "")
    if line and ", context " not in line:   # the server did not answer — the known context of the same model stays
        head = line.split(" (default model", 1)[0]
        kept = next((l for l in old.splitlines() if l.startswith(head + ", context ")), None)
        if kept:
            new = new.replace(line, kept)
    changed = not old or old.split("\n", 1)[-1] != new.split("\n", 1)[-1]
    if changed:
        write_block(ENV_START, ENV_END, new)
        info(color(32, f"  environment written to {AGENTS_FILE}"))
    try:
        os.makedirs(FC_DIR, exist_ok=True)
        with open(ENV_STAMP, "w") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S\n"))
    except OSError:
        pass
    return changed


def stage_connect():
    """Stage 1: a local model server + a safe opencode.json."""
    info("freecode — stage 1: connection to a local model")
    global_file = global_config()
    return connect_existing(global_file) if global_file else connect_new()


def connect_existing(global_file):
    """The file exists: only add the missing safeguards (enabled_providers, small_model)."""
    problems, _, _ = check(HOME)
    if not problems:
        info(color(32, f"  {global_file}: all providers local, nothing to change")); mark_configured(); return 0
    try:
        c = jsonc(open(global_file, encoding="utf-8").read())
    except ValueError as e:
        info(color(31, f"  {global_file} is broken ({e}) — fix it by hand")); return 1
    local_ids = [pid for pid, p in (c.get("provider") or {}).items()
               if is_local(((p or {}).get("options") or {}).get("baseURL") or "")]
    changes = {}
    if not c.get("enabled_providers") and local_ids:
        changes["enabled_providers"] = local_ids
    if not c.get("small_model") and provider_of(c.get("model")) in (changes.get("enabled_providers") or c.get("enabled_providers") or []):
        changes["small_model"] = c["model"]
    if changes:
        info(f"  {global_file} — proposed addition:")
        for k, v in changes.items():
            info(f"    \"{k}\": {json.dumps(v, ensure_ascii=False)}")
        if global_file.endswith(".jsonc"):
            info("  (.jsonc file — saving will remove the comments)")
        if tty_input("Save? (y/n)", "y").lower().startswith(("t", "y")):
            c.update(changes); save(global_file, c)
    problems, _, _ = check(HOME)
    for p in problems:
        info(color(33, f"  ! {p}"))
    if problems:
        info("  Fix the above by hand and run: freecode --check"); return 1
    mark_configured(); return 0


def connect_new():
    """No file: detect a local server, pick a model, write a new opencode.json with agents."""
    url, model = os.environ.get("FREECODE_URL"), os.environ.get("FREECODE_MODEL")
    if not url:
        for name, port in SERVERS:
            u = f"http://127.0.0.1:{port}/v1"
            m = server_models(u)
            if m:
                info(color(32, f"  found {name} on :{port} ({len(m)} models)")); url = u; break
    if not url:
        url = tty_input("No local model server found. Address of an OpenAI-compatible API", "")
    if not url:
        info(color(31, "  no model server — start llama.cpp / Ollama / LM Studio and repeat: freecode --configure")); return 1
    if not is_local(url):
        info(color(31, f"  {url} is not local (add the host to FREECODE_HOSTS if it is your own server in the LAN)")); return 1
    available = server_models(url) or []
    if not model:
        if available:
            for i, m in enumerate(available, 1):
                info(f"    {i}. {m}")
            choice = tty_input("Model (number or name)", "1")
            model = available[int(choice) - 1] if choice.isdigit() and 0 < int(choice) <= len(available) else choice
        else:
            model = tty_input("The server gave no model list. Model name", "")
    if not model:
        info(color(31, "  no model chosen")); return 1
    entry = {"name": f"{model} (lokalnie)"}
    ctx = server_ctx(url)
    if ctx:
        entry["limit"] = {"context": ctx, "output": min(8192, ctx // 4)}
    # thinking limits (llama.cpp thinking_budget_tokens); "auto" picks them via the auto-thinking plugin
    entry["variants"] = {**{k: {"thinking_budget_tokens": b} for k, b in THINKING_BUDGETS.items()},
                         "auto": {"auto_thinking": list(THINKING_BUDGETS.values()),
                                  "chat_template_kwargs": {"enable_thinking": True}},
                         "none": {"chat_template_kwargs": {"enable_thinking": False}}}
    cfg = {
        "$schema": "https://opencode.ai/config.json",
        "enabled_providers": ["local"],
        "model": f"local/{model}",
        "small_model": f"local/{model}",
        "share": "disabled",
        "provider": {"local": {"npm": "@ai-sdk/openai-compatible", "options": {"baseURL": url},
                               "models": {model: entry}}},
    }
    repo_agents = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "agents")
    for f in ["AGENTS.md"] + [f"prompts/{a}.txt" for a in AGENT_PROMPTS]:  # from the repo (bootstrap) when there are no own copies
        src, dst = os.path.join(repo_agents, f), os.path.join(OC_DIR, f)
        if os.path.isfile(src) and not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True); shutil.copy2(src, dst)
    agents = {a: {"mode": mode, "prompt": f"{{file:./prompts/{a}.txt}}",
                  **({} if edit else {"permission": {"edit": "deny"}})}
              for a, (mode, edit) in AGENT_PROMPTS.items() if os.path.isfile(os.path.join(OC_DIR, "prompts", f"{a}.txt"))}
    if agents:
        cfg["agent"] = agents
        if "general" in agents:
            cfg["default_agent"] = "general"
    save(os.path.join(OC_DIR, "opencode.json"), cfg)
    problems, _, _ = check(HOME)
    for p in problems:
        info(color(33, f"  ! {p}"))
    if problems:
        return 1
    mark_configured(); return 0


