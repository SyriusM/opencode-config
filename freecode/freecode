#!/usr/bin/env python3
"""freecode — opencode tylko na lokalnych modelach.

  freecode [argumenty opencode]   sprawdza konfigurację i uruchamia opencode (TUI albo `run`)
  freecode --konfiguruj           konfigurator (sam odpala się tylko raz, przy pierwszym starcie)
  freecode --sprawdz              tylko kontrola konfiguracji (kod 0 = można startować)
  freecode --version              wersja freecode i opencode pod spodem

freecode to NAKŁADKA na niezmieniony opencode, nie fork: opencode aktualizuje się normalnie
(npm i -g @opencode/cli), a freecode przy każdym starcie pilnuje, żeby działał tylko na lokalnych modelach.

Dlaczego: opencode 2.x bez poprawnej konfiguracji (brak pliku, uszkodzony JSON, brak lokalnego
`small_model`) po cichu wysyła rozmowę do darmowych modeli w chmurze. freecode przed każdym startem
sprawdza wszystkie źródła konfiguracji i odmawia startu, jeśli którykolwiek dostawca nie jest lokalny.
Potem uruchamia opencode z `--standalone` (własny serwer z właśnie sprawdzoną konfiguracją; usługa
w tle trzyma konfigurację z chwili swojego startu) i z wyłączoną autoaktualizacją i pobieraniem
listy modeli.

Zmienne: FREECODE_HOSTY (dodatkowe dozwolone hosty, po przecinku, np. adres serwera w LAN),
FREECODE_OPENCODE (ścieżka do opencode), FREECODE_URL + FREECODE_MODEL (konfigurator bez pytań).
"""
import ipaddress
import json
import os
import shutil
import sys
import time
import urllib.parse
import urllib.request

WERSJA = "0.1"
HOME = os.path.expanduser("~")
XDG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
OC_DIR = os.environ.get("OPENCODE_CONFIG_DIR") or os.path.join(XDG, "opencode")
FC_DIR = os.path.join(XDG, "freecode")
ZNACZNIK = os.path.join(FC_DIR, "skonfigurowane")
NAZWY = ("opencode.jsonc", "opencode.json", "config.json")
# standardowe porty lokalnych serwerów modeli
SERWERY = [("llama.cpp", 8080), ("Ollama", 11434), ("LM Studio", 1234), ("vLLM", 8000)]


def kolor(k, s):
    return f"\033[{k}m{s}\033[0m" if sys.stderr.isatty() else s


def info(s):
    print(s, file=sys.stderr)


# ── JSONC: komentarze // i /* */ oraz przecinki na końcu, poza stringami ──────────────────────
def jsonc(tekst):
    out, i, n, w_str = [], 0, len(tekst), False
    while i < n:
        c = tekst[i]
        if w_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(tekst[i + 1]); i += 1
            elif c == '"':
                w_str = False
        elif c == '"':
            w_str = True; out.append(c)
        elif tekst.startswith("//", i):
            while i < n and tekst[i] != "\n":
                i += 1
            continue
        elif tekst.startswith("/*", i):
            j = tekst.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        else:
            out.append(c)
        i += 1
    s = "".join(out)
    # przecinek przed } albo ] (poza stringami — stringi już nie zawierają komentarzy, ale mogą zawierać ",}")
    wynik, w_str, i = [], False, 0
    while i < len(s):
        c = s[i]
        if w_str:
            wynik.append(c)
            if c == "\\" and i + 1 < len(s):
                wynik.append(s[i + 1]); i += 1
            elif c == '"':
                w_str = False
        elif c == '"':
            w_str = True; wynik.append(c)
        elif c == ",":
            j = i + 1
            while j < len(s) and s[j] in " \t\r\n":
                j += 1
            if j >= len(s) or s[j] not in "}]":
                wynik.append(c)
        else:
            wynik.append(c)
        i += 1
    return json.loads("".join(wynik))


# ── źródła konfiguracji, w kolejności nakładania ─────────────────────────────────────────────
def zrodla(katalog):
    lista = [os.path.join(OC_DIR, n) for n in NAZWY]
    if os.environ.get("OPENCODE_CONFIG"):
        lista.append(os.environ["OPENCODE_CONFIG"])
    if not os.environ.get("OPENCODE_DISABLE_PROJECT_CONFIG"):
        # pliki projektu: od katalogu startu w górę do korzenia repozytorium git (albo katalogu domowego)
        projekt, d = [], os.path.abspath(katalog)
        while True:
            for n in ("opencode.jsonc", "opencode.json", ".opencode/opencode.jsonc", ".opencode/opencode.json"):
                p = os.path.join(d, n)
                if os.path.abspath(os.path.dirname(p)) != os.path.abspath(OC_DIR):
                    projekt.append(p)
            if os.path.exists(os.path.join(d, ".git")) or d in (HOME, "/"):
                break
            d = os.path.dirname(d)
        lista += reversed(projekt)
    pliki = [(p, None) for p in lista if os.path.isfile(p)]
    if os.environ.get("OPENCODE_CONFIG_CONTENT"):
        pliki.append(("$OPENCODE_CONFIG_CONTENT", os.environ["OPENCODE_CONFIG_CONTENT"]))
    return pliki


def lokalny(url):
    try:
        host = urllib.parse.urlparse(url).hostname or ""
    except ValueError:
        return False
    dodatkowe = [h.strip() for h in os.environ.get("FREECODE_HOSTY", "").split(",") if h.strip()]
    if host == "localhost" or host in dodatkowe:
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def dostawca(model):
    return model.split("/", 1)[0] if isinstance(model, str) and "/" in model else None


def sprawdz(katalog="."):
    """Zwraca (problemy, połączona konfiguracja, główny plik). Pusta lista problemów = można startować."""
    problemy, polaczona, dostawcy = [], {}, {}
    pliki = zrodla(katalog)
    if not pliki:
        return ["brak konfiguracji opencode (uruchom: freecode --konfiguruj)"], {}, None
    for sciezka, tresc in pliki:
        try:
            c = jsonc(tresc if tresc is not None else open(sciezka, encoding="utf-8").read())
            if not isinstance(c, dict):
                raise ValueError("to nie jest obiekt JSON")
        except (ValueError, OSError) as e:
            problemy.append(f"{sciezka}: nie da się odczytać ({e})")
            continue
        for k, v in c.items():
            if k == "provider" and isinstance(v, dict):
                for pid, p in v.items():
                    dostawcy.setdefault(pid, {}).update(p if isinstance(p, dict) else {})
            elif k == "agent" and isinstance(v, dict):
                for a, cfg in v.items():
                    polaczona.setdefault("agent", {}).setdefault(a, {}).update(cfg if isinstance(cfg, dict) else {})
            else:
                polaczona[k] = v
    if problemy:
        return problemy, polaczona, pliki[0][0]
    polaczona["provider"] = dostawcy

    wlaczeni = polaczona.get("enabled_providers")
    if not isinstance(wlaczeni, list) or not wlaczeni:
        problemy.append("brak `enabled_providers` — bez tej listy opencode może użyć dostawców w chmurze")
        wlaczeni = []
    for pid in wlaczeni:
        url = ((dostawcy.get(pid) or {}).get("options") or {}).get("baseURL")
        if not url:
            problemy.append(f"dostawca `{pid}` nie ma `options.baseURL` — nie wiadomo, czy jest lokalny")
        elif not lokalny(url):
            problemy.append(f"dostawca `{pid}` nie jest lokalny ({url}); dozwolone: localhost, 127.0.0.0/8, ::1, FREECODE_HOSTY")
    modele = [("model", polaczona.get("model")), ("small_model", polaczona.get("small_model"))]
    modele += [(f"agent.{a}.model", cfg.get("model")) for a, cfg in (polaczona.get("agent") or {}).items() if cfg.get("model")]
    for nazwa, m in modele:
        if not m:
            problemy.append(f"brak `{nazwa}` — opencode dobierze model sam, także z chmury"
                            + (" (small_model służy m.in. do tytułów sesji)" if nazwa == "small_model" else ""))
        elif dostawca(m) not in wlaczeni:
            problemy.append(f"`{nazwa}` = {m}: dostawca spoza `enabled_providers`")
    return problemy, polaczona, pliki[0][0]


# ── konfigurator ─────────────────────────────────────────────────────────────────────────────
def tty_input(pytanie, domyslna=""):
    if os.environ.get("FREECODE_TAK") or not os.path.exists("/dev/tty"):
        return domyslna
    try:
        with open("/dev/tty", "r+") as t:
            t.write(f"  {pytanie} [{domyslna}]: "); t.flush()
            odp = t.readline().strip()
    except OSError:
        return domyslna
    return odp or domyslna


def modele_serwera(url):
    try:
        with urllib.request.urlopen(url.rstrip("/") + "/models", timeout=3) as r:
            d = json.load(r)
        return [m.get("id") for m in d.get("data", []) if m.get("id")]
    except (OSError, ValueError):
        return None


def zapisz(sciezka, dane):
    os.makedirs(os.path.dirname(sciezka), exist_ok=True)
    if os.path.exists(sciezka):
        kopia = f"{sciezka}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(sciezka, kopia)
        info(f"  kopia: {kopia}")
    tmp = sciezka + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(dane, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, sciezka)
    info(kolor(32, f"  zapisano {sciezka}"))


def oznacz():
    os.makedirs(FC_DIR, exist_ok=True)
    with open(ZNACZNIK, "w") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S\n"))


def konfiguruj():
    info("freecode — konfiguracja (jednorazowa; ponownie: freecode --konfiguruj)")
    globalny = next((os.path.join(OC_DIR, n) for n in NAZWY if os.path.isfile(os.path.join(OC_DIR, n))), None)

    if globalny:
        problemy, _, _ = sprawdz(HOME)
        if not problemy:
            info(kolor(32, f"  {globalny}: wszyscy dostawcy lokalni, nic do zmiany")); oznacz(); return 0
        try:
            c = jsonc(open(globalny, encoding="utf-8").read())
        except ValueError as e:
            info(kolor(31, f"  {globalny} jest uszkodzony ({e}) — popraw go ręcznie")); return 1
        lokalni = [pid for pid, p in (c.get("provider") or {}).items()
                   if lokalny(((p or {}).get("options") or {}).get("baseURL") or "")]
        zmiany = {}
        if not c.get("enabled_providers") and lokalni:
            zmiany["enabled_providers"] = lokalni
        if not c.get("small_model") and dostawca(c.get("model")) in (zmiany.get("enabled_providers") or c.get("enabled_providers") or []):
            zmiany["small_model"] = c["model"]
        if zmiany:
            info(f"  {globalny} — proponowane uzupełnienie:")
            for k, v in zmiany.items():
                info(f"    \"{k}\": {json.dumps(v, ensure_ascii=False)}")
            if globalny.endswith(".jsonc"):
                info("  (plik .jsonc — zapis usunie komentarze)")
            if tty_input("Zapisać? (t/n)", "t").lower().startswith(("t", "y")):
                c.update(zmiany); zapisz(globalny, c)
        problemy, _, _ = sprawdz(HOME)
        for p in problemy:
            info(kolor(33, f"  ! {p}"))
        if problemy:
            info("  Popraw powyższe ręcznie i uruchom: freecode --sprawdz"); return 1
        oznacz(); return 0

    # brak konfiguracji — wykrycie lokalnego serwera
    url, model = os.environ.get("FREECODE_URL"), os.environ.get("FREECODE_MODEL")
    if not url:
        for nazwa, port in SERWERY:
            u = f"http://127.0.0.1:{port}/v1"
            m = modele_serwera(u)
            if m:
                info(kolor(32, f"  znaleziono {nazwa} na :{port} ({len(m)} modeli)")); url = u; break
    if not url:
        url = tty_input("Nie znaleziono lokalnego serwera modeli. Adres API zgodnego z OpenAI", "")
    if not url:
        info(kolor(31, "  brak serwera modeli — uruchom llama.cpp / Ollama / LM Studio i powtórz: freecode --konfiguruj")); return 1
    if not lokalny(url):
        info(kolor(31, f"  {url} nie jest lokalny (dodaj host do FREECODE_HOSTY, jeśli to twój serwer w LAN)")); return 1
    dostepne = modele_serwera(url) or []
    if not model:
        if dostepne:
            for i, m in enumerate(dostepne, 1):
                info(f"    {i}. {m}")
            wybor = tty_input("Model (numer albo nazwa)", "1")
            model = dostepne[int(wybor) - 1] if wybor.isdigit() and 0 < int(wybor) <= len(dostepne) else wybor
        else:
            model = tty_input("Serwer nie podał listy modeli. Nazwa modelu", "")
    if not model:
        info(kolor(31, "  nie wybrano modelu")); return 1
    zapisz(os.path.join(OC_DIR, "opencode.json"), {
        "$schema": "https://opencode.ai/config.json",
        "enabled_providers": ["local"],
        "model": f"local/{model}",
        "small_model": f"local/{model}",
        "share": "disabled",
        "provider": {"local": {"npm": "@ai-sdk/openai-compatible", "options": {"baseURL": url},
                               "models": {model: {"name": f"{model} (lokalnie)"}}}},
    })
    problemy, _, _ = sprawdz(HOME)
    for p in problemy:
        info(kolor(33, f"  ! {p}"))
    if problemy:
        return 1
    oznacz(); return 0


# ── start ────────────────────────────────────────────────────────────────────────────────────
def wersja_opencode(oc):
    """Wersja z package.json obok binarki (szybko), w razie czego `opencode --version`."""
    d = os.path.dirname(os.path.realpath(oc))
    for _ in range(4):
        p = os.path.join(d, "package.json")
        if os.path.isfile(p):
            try:
                v = json.load(open(p, encoding="utf-8")).get("version")
                if v:
                    return v
            except (ValueError, OSError):
                pass
        d = os.path.dirname(d)
    try:
        import subprocess
        r = subprocess.run([oc, "--version"], capture_output=True, text=True, timeout=10)
        return (r.stdout.strip().split() or ["?"])[-1].lstrip("v")
    except (OSError, subprocess.SubprocessError):
        return "?"


def opis(oc):
    return f"freecode {WERSJA} — nakładka na opencode {wersja_opencode(oc) if oc else '(nie znaleziono)'}, tylko lokalne modele"


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip()); return 0
    if argv[:1] in (["-v"], ["--version"]):
        print(opis(os.environ.get("FREECODE_OPENCODE") or shutil.which("opencode"))); return 0
    if argv[:1] == ["--konfiguruj"]:
        return konfiguruj()
    if not os.path.exists(ZNACZNIK) and argv[:1] != ["--sprawdz"]:
        kod = konfiguruj()
        if kod:
            return kod

    # katalog projektu: pierwszy argument niebędący flagą (TUI: `freecode katalog`)
    katalog = "."
    if argv and not argv[0].startswith("-") and os.path.isdir(argv[0]):
        katalog = argv[0]
    problemy, _, _ = sprawdz(katalog)
    if problemy:
        info(kolor(31, "freecode: nie uruchamiam opencode — konfiguracja nie jest w pełni lokalna:"))
        for p in problemy:
            info(f"  - {p}")
        info("Popraw konfigurację albo uruchom: freecode --konfiguruj")
        return 1
    if argv[:1] == ["--sprawdz"]:
        info(kolor(32, "freecode: konfiguracja lokalna")); return 0

    oc = os.environ.get("FREECODE_OPENCODE") or shutil.which("opencode")
    if not oc:
        info("freecode: nie znaleziono opencode (npm i -g @opencode/cli)"); return 1
    os.environ["OPENCODE_DISABLE_AUTOUPDATE"] = "1"
    os.environ["OPENCODE_DISABLE_MODELS_FETCH"] = "1"
    info(kolor(2, opis(oc)))
    sub = argv[0] if argv and not argv[0].startswith("-") and not os.path.isdir(argv[0]) else None
    if sub is None:                       # TUI
        args = [oc, "--standalone", *argv]
    elif sub == "run":
        args = [oc, "run", "--standalone", *argv[1:]]
    elif sub in ("upgrade", "update", "auth", "service", "acp"):
        info(f"freecode: `{sub}` łączy się z siecią albo z usługą w tle — użyj zwykłego opencode"); return 1
    else:
        args = [oc, *argv]
    if os.environ.get("WEZTERM_PANE") and sys.stdout.isatty():
        # WezTerm: znacznik karty (user var `freecode`) — format-window-title może pokazać „freecode” zamiast „OpenCode”
        sys.stdout.write("\033]1337;SetUserVar=freecode=MQ==\007"); sys.stdout.flush()
    os.execv(oc, args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
