def template_dir():
    for d in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "agents"),
              os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "freecode", "agents")):
        if os.path.isfile(os.path.join(d, "AGENTS.md")):
            return d
    return None


def sections(text):
    """{## heading: section content} — without the ENV/PREFS blocks."""
    out, name = {}, None
    for line in text.splitlines(keepends=True):
        if line.startswith("## "):
            name = line[3:].strip(); out[name] = line
        elif name:
            out[name] += line
    return out


def current_prefs(text):
    got = {}
    if PREFS_START in text:
        for line in text.split(PREFS_START, 1)[1].split(PREFS_END, 1)[0].splitlines():
            if line.startswith("<!-- pref "):
                k, _, v = line[10:].partition("=")
                got[k.strip()] = v.split("-->")[0].strip()
    return got


def write_block(start, end, block, before=None):
    text = open(AGENTS_FILE, encoding="utf-8").read() if os.path.isfile(AGENTS_FILE) else ""
    full = f"{start}\n{block}\n{end}"
    if start in text and end in text:
        head, rest = text.split(start, 1)
        text = head + full + rest.split(end, 1)[1]
    elif before and before in text:
        i = text.index(before); text = text[:i] + full + "\n\n" + text[i:]
    else:
        text = (text.rstrip("\n") + "\n\n" if text else "") + full + "\n"
    write_agents(text)


def write_agents(text):
    """Atomic write of AGENTS.md (the service may be reading it right now)."""
    os.makedirs(OC_DIR, exist_ok=True)
    tmp = AGENTS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, AGENTS_FILE)


def fix_config(tdir, yes):
    """opencode.json: main model context, small_model, agents. Returns the number of things that were OK or None (error)."""
    gfile = global_config()
    if not gfile:
        info(color(31, "  no opencode.json — first run: freecode --configure")); return None
    try:
        c = jsonc(open(gfile, encoding="utf-8").read())
    except ValueError as e:
        info(color(31, f"  {gfile} is broken ({e})")); return None
    changed, n_ok = False, 0

    # 1. main model context vs. the server (we ask only the main model's server — others would wake up)
    pid, _, mname = (c.get("model") or "").partition("/")
    prov = (c.get("provider") or {}).get(pid) or {}
    url = (prov.get("options") or {}).get("baseURL")
    entry = (prov.get("models") or {}).get(mname)
    ctx = server_ctx(url) if url else None
    if entry is not None and ctx:
        lim = (entry.get("limit") or {}).get("context")
        if not lim or lim > ctx:
            info(color(33, f"  ! {c['model']}: limit.context = {lim or 'none'}, the server gives {ctx} per conversation"
                           + (" — opencode will overflow the window" if lim else " — opencode does not know when to compact")))
            if yes(f"Set limit.context = {ctx}, output = {min(8192, ctx // 4)}?"):
                entry["limit"] = {"context": ctx, "output": min(8192, ctx // 4)}; changed = True
        else:
            n_ok += 1; info(color(32, f"  ok context: {lim} of {ctx}" + (" (less — deliberately, less RAM for cache)" if lim < ctx else "")))
    elif url:
        info(color(2, f"  - context: server {url} gave no /props (not llama.cpp, or asleep) — skipping"))

    # 2. small_model lokalny
    if not c.get("small_model") and c.get("model"):
        info(color(33, "  ! no small_model — session titles may go to the cloud"))
        if yes(f"Set small_model = {c['model']}?"):
            c["small_model"] = c["model"]; changed = True
    else:
        n_ok += 1

    # 3. agenci ze wzorca
    agents = c.setdefault("agent", {})
    for a, (mode, edit) in AGENT_PROMPTS.items():
        if a in agents:
            n_ok += 1; continue
        dst = os.path.join(OC_DIR, "prompts", f"{a}.txt")
        src = os.path.join(tdir, "prompts", f"{a}.txt") if tdir else ""
        if not os.path.isfile(dst) and not os.path.isfile(src):
            continue
        info(color(33, f"  ! no agent `{a}` ({mode}{'' if edit else ', no editing'})"))
        if yes(f"Add agent `{a}`?"):
            if not os.path.isfile(dst):
                os.makedirs(os.path.dirname(dst), exist_ok=True); shutil.copy2(src, dst)
            agents[a] = {"mode": mode, "prompt": f"{{file:./prompts/{a}.txt}}", **({} if edit else {"permission": {"edit": "deny"}})}
            changed = True
    if not agents:
        c.pop("agent")
    if changed:
        save(gfile, c)
    return n_ok


def fix_agents_md(tdir, yes):
    """AGENTS.md sections from the template that the user is missing (existing ones are left alone). Returns 1 = it was OK."""
    n_ok = 0
    if tdir:
        mine = open(AGENTS_FILE, encoding="utf-8").read() if os.path.isfile(AGENTS_FILE) else ""
        have = sections(mine)
        missing = [(k, v) for k, v in sections(open(os.path.join(tdir, "AGENTS.md"), encoding="utf-8").read()).items()
                   if k not in have and not k.startswith("Environment")]
        if missing:
            info(color(33, "  ! AGENTS.md is missing sections: " + ", ".join(k for k, _ in missing)))
            if yes("Add them (before Learned Rules, the rest of the file unchanged)?"):
                if os.path.isfile(AGENTS_FILE):
                    shutil.copy2(AGENTS_FILE, f"{AGENTS_FILE}.bak-{time.strftime('%Y%m%d-%H%M%S')}")
                add = "".join(v.rstrip("\n") + "\n\n" for k, v in missing if k != "Learned Rules")
                if "## Learned Rules" in mine:
                    i = mine.index("## Learned Rules"); mine = mine[:i] + add + mine[i:]
                else:
                    mine = mine.rstrip("\n") + "\n\n" + add + dict(missing).get("Learned Rules", "")
                write_agents(mine); info(color(32, f"  added {len(missing)} section(s)"))
        else:
            n_ok += 1
    else:
        info(color(2, "  - no agents/ template (repo or ~/.local/share/freecode/agents) — skipping AGENTS.md"))
    return n_ok


def stage_template():
    """Stage 2: configuration and AGENTS.md vs. the template — every fix asks y/n."""
    info("freecode — stage 2: conformity with the template (every change asks first; FREECODE_YES = default answers)")
    yes = lambda q: tty_input(q + " (y/n)", "y").lower().startswith(("t", "y"))
    tdir = template_dir()
    n_ok = fix_config(tdir, yes)
    if n_ok is None:
        return 1
    n_ok += fix_agents_md(tdir, yes)
    info(color(32, f"  stage 2 done ({n_ok} things were already OK)"))
