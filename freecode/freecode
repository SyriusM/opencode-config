def configure(stages="1234"):
    """Stages in order (all by default; first start = "14"). A failed stage stops the following ones."""
    for n in stages:
        if globals()[STAGES[n]]():
            return 1
    if len(stages) > 2:
        info(color(32, "freecode: configuration ready. The service picks up the changes at the next freecode start."))
    return 0


# ── background service (TUI) ───────────────────────────────────────────────────────────────────────
SERVICE_JSON = os.path.join(HOME, ".local", "state", "opencode", "service.json")
RELOAD_STAMP = os.path.join(FC_DIR, "service-reloaded")   # service pid; mtime = when it last loaded the configuration


def proc_start(pid):
    """Process start time (epoch) from /proc; None when there is no such process."""
    try:
        fields = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
        btime = next(int(l.split()[1]) for l in open("/proc/stat") if l.startswith("btime "))
        return btime + int(fields[19]) / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, StopIteration):
        return None


def service_mode(oc, directory):
    """Whether the TUI can go through the background service (one server for the terminal and the phone).

    Returns None (yes) or the reason why `--standalone` is needed. The service keeps the configuration
    from its start or the last `opencode reload`: when any configuration file is
    newer and the service is idle, we tell it to reload the configuration (`opencode reload` — the same
    process, sessions stay); a restart only when the reload fails or the service has its configuration from
    environment variables. When it is busy (e.g. a session from the phone), we leave it alone and start a private server.
    """
    if os.environ.get("FREECODE_STANDALONE"):
        return "FREECODE_STANDALONE"
    env_cfg = [k for k in ("OPENCODE_CONFIG", "OPENCODE_CONFIG_CONTENT", "OPENCODE_CONFIG_DIR", "XDG_CONFIG_HOME")
               if os.environ.get(k)]
    if env_cfg:
        return "configuration from variables " + ", ".join(env_cfg) + " (the service does not see it)"
    try:
        svc = json.load(open(SERVICE_JSON, encoding="utf-8"))
        pid = int(svc["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        return None                      # the service is not running — opencode will start it with the checked configuration
    started = proc_start(pid)
    if started is None:
        return None
    try:                                 # the stamp counts only for the same service process
        if int(open(RELOAD_STAMP).read().strip()) == pid:
            started = max(started, os.path.getmtime(RELOAD_STAMP))
    except (OSError, ValueError):
        pass
    reasons = []
    missing = []
    try:
        env = dict(l.split("=", 1) for l in open(f"/proc/{pid}/environ").read().split("\0") if "=" in l)
        for k in ("OPENCODE_DISABLE_AUTOUPDATE", "OPENCODE_DISABLE_MODELS_FETCH"):
            if env.get(k) != "1":
                missing.append(k)
        if missing:
            return "the service lacks the anti-network flags: " + ", ".join(missing)
        reasons += [f"the service has {k}" for k in ("OPENCODE_CONFIG", "OPENCODE_CONFIG_CONTENT", "OPENCODE_CONFIG_DIR",
                                                "XDG_CONFIG_HOME") if env.get(k)]
    except OSError:
        reasons.append("cannot read the service environment")
    need_restart = bool(reasons)         # reload does not change the process environment
    reasons += [f"{p} changed after the service started" for p, content in sources(directory)
                if content is None and os.path.getmtime(p) > started]
    prompts_dir = os.path.join(OC_DIR, "prompts")   # the service also reads rules and prompts only at start
    rules = [AGENTS_FILE] + ([os.path.join(prompts_dir, f) for f in os.listdir(prompts_dir)]
                             if os.path.isdir(prompts_dir) else [])
    reasons += [f"{p} changed after the service started" for p in rules
                if os.path.isfile(p) and os.path.getmtime(p) > started]
    if not reasons:
        return None
    try:
        import base64
        auth = base64.b64encode(f"opencode:{svc['password']}".encode()).decode()
        req = urllib.request.Request(svc["url"].rstrip("/") + "/api/session/active",
                                     headers={"Authorization": "Basic " + auth})
        with urllib.request.urlopen(req, timeout=3) as r:
            busy = bool(json.load(r).get("data"))
    except (OSError, ValueError, KeyError, AttributeError):
        busy = True
    if busy:
        return "the service has an outdated configuration (" + "; ".join(reasons) + ") and is busy with a session — not interrupting it"
    if not need_restart:
        t0 = time.time()                 # a file change during the reload should be seen next time
        info(color(2, "freecode: the background service is reloading the configuration (" + "; ".join(reasons) + ")"))
        try:
            r = subprocess.run([oc, "reload"], capture_output=True, text=True, timeout=60)
            ok = r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            ok = False
        if ok:
            try:
                os.makedirs(FC_DIR, exist_ok=True)
                with open(RELOAD_STAMP, "w") as f:
                    f.write(str(pid))
                os.utime(RELOAD_STAMP, (t0, t0))
            except OSError:
                pass
            return None
    info(color(2, "freecode: restarting the background service (" + "; ".join(reasons) + ")"))
    r = subprocess.run([oc, "service", "restart"], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return "service restart failed: " + (r.stderr.strip() or r.stdout.strip())[:200]
    return None


# ── start ────────────────────────────────────────────────────────────────────────────────────
def opencode_version(oc):
    """Version from package.json next to the binary (fast), otherwise `opencode --version`."""
    d = os.path.dirname(os.path.realpath(oc))
    for _ in range(4):
        p = os.path.join(d, "package.json")
        if os.path.isfile(p):
            try:
                v = json.load(open(p, encoding="utf-8")).get("version")
                if v:
                    return v
            except (ValueError, OSError):
                pass
        d = os.path.dirname(d)
    try:
        r = subprocess.run([oc, "--version"], capture_output=True, text=True, timeout=10)
        return (r.stdout.strip().split() or ["?"])[-1].lstrip("v")
    except (OSError, subprocess.SubprocessError):
        return "?"


def describe(oc):
    return f"freecode {VERSION} — a wrapper around opencode {opencode_version(oc) if oc else '(not found)'}, local models only"


def guard(directory):
    """Pre-start check: every provider local. False = we do not start."""
    problems, _, _ = check(directory)
    if problems:
        info(color(31, "freecode: not starting opencode — the configuration is not fully local:"))
        for p in problems:
            info(f"  - {p}")
        info("Fix the configuration or run: freecode --configure")
        # log of a refused start: one JSON line, only when problems is not empty
        entry = {
            "time": time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime()),
            "cwd": directory,
            "argv": sys.argv[1:],
            "problems": problems,
        }
        try:
            os.makedirs(FC_DIR, exist_ok=True)
            with open(AUDIT_LOG, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
        except OSError:
            pass
    return not problems


def refresh_env(directory):
    """Keeps the computer description fresh: checked at most once a day or after a config change (model, context).

    Age counted from the ENV_STAMP marker, not the mtime of AGENTS.md — a check without changes does not touch the file.
    """
    if not os.path.isfile(AGENTS_FILE):
        return
    last = os.path.getmtime(ENV_STAMP) if os.path.isfile(ENV_STAMP) else os.path.getmtime(AGENTS_FILE)
    cfgs = [os.path.getmtime(p) for p, c in sources(directory) if c is None]
    if time.time() - last > 86400 or any(t > last for t in cfgs):
        try:
            write_env()
        except OSError:
            pass


def refusal(argv):
    """Reason why freecode will not pass a command to opencode (network, exposing a server); None = allowed."""
    for i, a in enumerate(argv):         # `--server URL` bypasses the service and the config check — local address only
        url = a.split("=", 1)[1] if a.startswith("--server=") else argv[i + 1] if a == "--server" and i + 1 < len(argv) else None
        if url and not is_local(url):
            return f"`--server {url}`: the address is not local (add your own host to FREECODE_HOSTS)"
    words = [a for a in argv if not a.startswith("-")]
    sub, sub2 = (words + [None, None])[:2]
    if sub in ("upgrade", "update", "auth", "service", "acp"):
        return f"`{sub}` connects to the network or to the background service"
    if sub == "uninstall":
        return "`uninstall` removes opencode"
    if sub == "plugin" and sub2 in ("add", "check", "update"):
        return f"`plugin {sub2}` downloads packages from the network"
    if sub == "mcp" and sub2 == "auth":
        return "`mcp auth` logs in to a remote MCP server"
    if sub == "pair":
        if "--remote" in argv:
            return "`pair --remote` exposes the server to the internet"
        for i, a in enumerate(argv):
            url = a.split("=", 1)[1] if a.startswith("--url=") else argv[i + 1] if a == "--url" and i + 1 < len(argv) else None
            if url and not is_local(url):
                return f"`pair --url {url}`: the address is not local"
    if sub == "session" and sub2 == "import":
        src = words[2] if len(words) > 2 else ""
        if "://" in src and not is_local(src):
            return f"`session import {src}`: the address is not local"
    return None


def launch_args(oc, argv, directory):
    """The opencode command: TUI via the service or a private server, `run` always standalone. None = refused."""
    os.environ["OPENCODE_DISABLE_AUTOUPDATE"] = "1"
    os.environ["OPENCODE_DISABLE_MODELS_FETCH"] = "1"
    info(color(2, describe(oc)))
    sub = argv[0] if argv and not argv[0].startswith("-") and not os.path.isdir(argv[0]) else None
    why = refusal(argv)
    if why:
        info(f"freecode: {why} — use plain opencode"); return None
    if sub is None:                       # TUI
        own = "--standalone" in argv or any(a == "--server" or a.startswith("--server=") for a in argv)
        why = None if own else service_mode(oc, directory)
        if own or why is None:
            args = [oc, *argv]            # background service: the same session in the terminal and on the phone
        else:
            info(color(33, f"freecode: private server — {why}"))
            args = [oc, "--standalone", *argv]
    elif sub == "run":
        args = [oc, "run", "--standalone", *argv[1:]]
    else:
        args = [oc, *argv]
    if os.environ.get("WEZTERM_PANE") and sys.stdout.isatty():
        # WezTerm: tab marker (user var `freecode`) — format-window-title can show "freecode" instead of "OpenCode"
        sys.stdout.write("\033]1337;SetUserVar=freecode=MQ==\007"); sys.stdout.flush()
    return args


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip()); return 0
    if argv[:1] in (["-v"], ["--version"]):
        print(describe(os.environ.get("FREECODE_OPENCODE") or shutil.which("opencode"))); return 0
    # old names stay as aliases
    argv = [{"--konfiguruj": "--configure", "--sprawdz": "--check", "--optimize": "--configure",
             "--optymalizuj": "--configure"}.get(a, a) for a in argv[:1]] + argv[1:]
    if argv[:1] == ["--env"]:
        if not write_env():
            info(color(2, f"  environment unchanged ({AGENTS_FILE})"))
        return 0
    if argv[:1] == ["--configure"]:
        stages = "".join(argv[1:]) or "1234"
        if not stages or any(n not in STAGES for n in stages):
            info("  stages: 1 connection, 2 template, 3 work style, 4 computer description (e.g. freecode --configure 3)"); return 1
        return configure(stages)
    if argv[:1] == ["--set"]:
        return set_prefs(argv[1:])
    if argv[:1] == ["--undo"]:
        return undo_prefs()
    if not os.path.exists(MARKER) and not os.path.exists(OLD_MARKER) and argv[:1] != ["--check"]:
        code = configure("14")
        if code:
            return code

    directory = argv[0] if argv and not argv[0].startswith("-") and os.path.isdir(argv[0]) else "."
    if not guard(directory):
        return 1
    if argv[:1] == ["--check"]:
        info(color(32, "freecode: configuration is local")); return 0
    refresh_env(directory)
    oc = os.environ.get("FREECODE_OPENCODE") or shutil.which("opencode")
    if not oc:
        info("freecode: opencode not found (npm i -g @opencode/cli)"); return 1
    args = launch_args(oc, argv, directory)
    if args is None:
        return 1
    os.execv(oc, args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
