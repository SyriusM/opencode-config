#!/home/user/mempalace/.venv/bin/python
"""Kopalnia błędów i rozwiązań opencode: plik w ~/oc-audyt/kopalnia/ + wpis w OSOBNYM pałacu ~/.mempalace-opencode
(wing opencode, room bledy) — wnioski modeli nie mieszają się z osobistą pamięcią użytkownika w ~/.mempalace.

  lesson-note                                   ile wniosków i ostatnie 5
  lesson-note search "komunikat albo słowa"     znane rozwiązania (dokładne słowa w plikach + podobne w mempalace)
  lesson-note add "OBJAW" "PRZYCZYNA" "NAPRAWA" ["PRZYKŁAD poprawnego wywołania"]
        OBJAW     = komunikat błędu albo co się działo (dosłownie, krótko)
        PRZYCZYNA = dlaczego (jedno zdanie)
        NAPRAWA   = co zmieniono i gdzie (plik, reguła) albo jak to obejść
  lesson-note backfill                          dopisz do mempalace wnioski, które są tylko w plikach
Zgodność wstecz: szukaj = search, dodaj = add, uzupelnij = backfill.

Zabezpieczenia: najwyżej 15 nowych wniosków dziennie; w trakcie miningu pałacu zapis idzie tylko do pliku
(potem `backfill`); plik jest źródłem prawdy — przerwany zapis do pałacu niczego nie gubi.
"""
import datetime, os, re, sys, contextlib, io, sqlite3, subprocess

# Osobny pałac — musi być ustawiony PRZED importem mempalace.
os.environ["MEMPALACE_CONFIG_DIR"] = os.path.expanduser("~/.mempalace-opencode")
os.environ.pop("MEMPALACE_PALACE_PATH", None)
os.environ.pop("MEMPAL_PALACE_PATH", None)

LESSONS_DIR = os.path.expanduser("~/oc-audyt/kopalnia")
WING, ROOM = "opencode", "bledy"


def quiet(f, *a, **k):
    """mempalace wypisuje ostrzeżenia telemetrii na stderr — nie zaśmiecaj nimi wyniku"""
    with contextlib.redirect_stderr(io.StringIO()), contextlib.redirect_stdout(io.StringIO()):
        return f(*a, **k)


def lesson_files():
    os.makedirs(LESSONS_DIR, exist_ok=True)
    return sorted(f for f in os.listdir(LESSONS_DIR) if f.endswith(".md"))


def shorten(t, n=110):
    t = " ".join(t.split())
    return t if len(t) <= n else t[: n - 1] + "…"


DAILY_LIMIT = 15
THRESHOLD = 0.55  # minimalne podobieństwo dla trafienia samym znaczeniem (zmierzone: trafne 0,56–0,74, luźne ~0,50–0,53, obce ~0,3)
PALACE_DB = os.path.expanduser("~/.mempalace-opencode/palace/chroma.sqlite3")


def mining_running():
    """Ciężki zapis do pałacu z innego procesu (mining) — wtedy nie dokładamy własnych zapisów."""
    try:
        r = subprocess.run(["pgrep", "-af", "mempalace mine|mine_case"], capture_output=True, text=True)
        return any("pgrep" not in l and "lesson-note" not in l for l in r.stdout.splitlines())
    except Exception:
        return False


def in_palace():
    """Nazwy plików kopalni, które mają już wpis w mempalace (odczyt bazy tylko do odczytu)."""
    if not os.path.exists(PALACE_DB):
        return set()  # pałac jeszcze nie założony — żaden wniosek nie ma wpisu
    try:
        db = sqlite3.connect(f"file:{PALACE_DB}?mode=ro", uri=True)
        return {os.path.basename(r[0]) for r in db.execute(
            "select string_value from embedding_metadata where key='source_file' and string_value like '%oc-audyt/kopalnia%'")}
    except Exception:
        return None


def to_palace(file_path, content):
    if mining_running():
        return "trwa mining pałacu — wniosek tylko w pliku (później: lesson-note backfill)"
    try:
        from mempalace import mcp_server as m
        r = quiet(m.tool_add_drawer, wing=WING, room=ROOM, content=content, added_by="lesson-note", source_file=file_path)
        return "zapisano w pałacu opencode" if isinstance(r, dict) and r.get("success") else f"mempalace: {str(r)[:120]}"
    except Exception as e:  # plik i tak został — pałac można uzupełnić później
        return f"mempalace niedostępny ({type(e).__name__}); wniosek jest w pliku (później: lesson-note backfill)"


def backfill():
    have = in_palace()
    if have is None:
        sys.exit("Nie mogę odczytać bazy pałacu.")
    missing = [f for f in lesson_files() if f not in have]
    if not missing:
        print(f"Wszystkie wnioski ({len(lesson_files())}) są w mempalace.")
        return
    for f in missing:
        path = os.path.join(LESSONS_DIR, f)
        print(f"{f[:60]} — {to_palace(path, open(path, encoding='utf-8').read())}")


def add(symptom, cause, fix, example=""):
    symptom, cause, fix, example = (" ".join(x.split()) for x in (symptom, cause, fix, example))
    if min(len(symptom), len(cause), len(fix)) < 8:
        sys.exit("Każde z pól OBJAW, PRZYCZYNA, NAPRAWA musi mieć treść (min. 8 znaków).")
    for f in lesson_files():
        if symptom.lower() in open(os.path.join(LESSONS_DIR, f), encoding="utf-8").read().lower():
            print(f"Taki objaw już jest w kopalni: {f}")
            return
    today = datetime.date.today().isoformat()
    bulk = os.environ.get("OC_LESSON_BULK") or os.environ.get("OC_WNIOSEK_ZASILANIE")  # old name kept
    if bulk != "1" and sum(1 for f in lesson_files() if f.startswith(today)) >= DAILY_LIMIT:
        sys.exit(f"Limit {DAILY_LIMIT} nowych wniosków dziennie wyczerpany. Dopisz jutro albo połącz podobne wnioski w jeden.")
    name = re.sub(r"[^a-z0-9]+", "-", symptom.lower().translate(str.maketrans("ąćęłńóśźż", "acelnoszz")))[:50].strip("-") or "wniosek"
    file_path = os.path.join(LESSONS_DIR, f"{today}-{name}.md")
    content = f"# Błąd opencode i rozwiązanie ({today})\n\nOBJAW: {symptom}\nPRZYCZYNA: {cause}\nNAPRAWA: {fix}\n"
    if example:
        content += f"PRZYKŁAD: {example}\n"
    with open(file_path, "w", encoding="utf-8") as f:
        f.write(content)
    status = to_palace(file_path, content)
    print(f"Dodano: {os.path.basename(file_path)} — {status}")


STOPWORDS = set("""nie jest jak przy albo oraz dla tego ten that the and model modelu narzedzie narzedzia blad bledu error
przez jako tylko gdy kiedy sie nad pod bez ale czy jego jej ich ma sa to na do od po za ze co""".split())


def ascii_fold(t):
    return t.lower().translate(str.maketrans("ąćęłńóśźż", "acelnoszz"))


def search(q):
    """Wynik = wniosek, którego OBJAW zawiera większość istotnych słów zapytania ALBO jest znaczeniowo bliski (≥ PROG).
    Znaczeniowo szukamy TYLKO w pokoju błędów opencode — reszty pałacu (audio, sprzęt, prywatne notatki) nie pokazujemy."""
    words = [w for w in re.findall(r"\w+", ascii_fold(q)) if len(w) >= 4 and w not in STOPWORDS]
    hits = {}  # plik -> [udział słów w OBJAW, podobieństwo]
    for f in lesson_files():
        t = open(os.path.join(LESSONS_DIR, f), encoding="utf-8").read()
        symptom = ascii_fold(next((l for l in t.splitlines() if l.startswith("OBJAW: ")), ""))
        if words:
            share = sum(1 for w in words if w in symptom) / len(words)
            if share >= 0.6 and sum(1 for w in words if w in symptom) >= 2:
                hits[f] = [share, 0.0]
    try:
        from mempalace import mcp_server as m
        r = quiet(m.tool_search, q, limit=5, wing=WING, room=ROOM)
        for w in (r or {}).get("results") or []:
            sim = float(w.get("similarity") or 0)
            if w.get("room") != ROOM or sim < THRESHOLD:
                continue
            f = next((x for x in lesson_files() if x.startswith(str(w.get("source_file") or "\0")[:40])), None)
            if f:
                hits.setdefault(f, [0.0, 0.0])[1] = sim
    except Exception:
        pass
    if not hits:
        print("Brak znanych rozwiązań dla tego błędu — to nowy przypadek. Po naprawie dopisz go: lesson-note add …")
        return
    ranked = sorted(hits.items(), key=lambda kv: -(kv[1][0] + kv[1][1]))[:4]
    print(f"Znane rozwiązania ({len(ranked)}) — sprawdź, czy OBJAW pasuje do Twojego błędu, zanim zastosujesz:")
    for f, (share, sim) in ranked:
        t = open(os.path.join(LESSONS_DIR, f), encoding="utf-8").read()
        print(f"\n--- {f} (słowa {share:.0%}, podobieństwo {sim:.2f})")
        print("\n".join(l for l in t.splitlines() if l.startswith(("OBJAW", "PRZYCZYNA", "NAPRAWA", "PRZYKŁAD"))))


def main():
    a = sys.argv[1:]
    if not a:
        p = lesson_files()
        print(f"Wniosków w kopalni: {len(p)} (~/oc-audyt/kopalnia, pałac ~/.mempalace-opencode: {WING}/{ROOM})")
        for f in p[-5:]:
            t = open(os.path.join(LESSONS_DIR, f), encoding="utf-8").read()
            o = next((l[7:] for l in t.splitlines() if l.startswith("OBJAW: ")), "")
            print(f"- {f[:10]} {shorten(o)}")
    elif a[0] in ("search", "szukaj") and len(a) >= 2:
        search(" ".join(a[1:]))
    elif a[0] in ("backfill", "uzupelnij"):
        backfill()
    elif a[0] in ("add", "dodaj") and len(a) in (4, 5):
        add(*a[1:])
    else:
        print(__doc__)


main()
