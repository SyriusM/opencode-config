#!/bin/sh
# Password dialog for `sudo -A` — an agent (no terminal) can use sudo while a human types the password.
# Usage: SUDO_ASKPASS=~/bin/sudo-askpass sudo -A COMMAND
# Stores nothing (deliberately no KWallet: a saved password = root for every user process).
prompt="${1:-Password for sudo:}"
# show what the human is agreeing to: the command of the sudo process that opened this dialog (from /proc, the caller cannot fake it)
cmd=$(tr '\0' ' ' < "/proc/$PPID/cmdline" 2>/dev/null)
[ -n "$cmd" ] && prompt="$prompt

Command: $cmd

Not expecting this? Click Cancel."
if command -v kdialog >/dev/null 2>&1; then
  exec kdialog --title "sudo" --password "$prompt"
elif command -v zenity >/dev/null 2>&1; then
  exec zenity --password --title "sudo"
elif command -v ksshaskpass >/dev/null 2>&1; then
  exec ksshaskpass "$prompt"
elif command -v ssh-askpass >/dev/null 2>&1; then
  exec ssh-askpass "$prompt"
fi
echo "sudo-askpass: no dialog program found (install kdialog, zenity or ssh-askpass)" >&2
exit 1
