#!/usr/bin/env bash
# Automatyczne kopie plików konfiguracji opencode (robi je wtyczka tool-input-fix przed każdą zmianą).
#   backup-copy                  lista plików, które mają kopie (ile, ostatnia)
#   backup-copy FRAGMENT         kopie plików pasujących do fragmentu nazwy, np.: backup-copy AGENTS
#   backup-copy diff KOPIA       różnica: kopia → obecny plik
#   backup-copy przywroc KOPIA   przywraca plik z kopii (obecną wersję najpierw też zapisuje jako kopię)
set -u
K="$HOME/oc-audyt/auto-kopie"

# nazwa kopii: H__ścieżka__z__podkreśleniami.RRRRMMDD-GGMMSS → pełna ścieżka oryginału
cel() {
  local b
  b=$(basename "$1")
  b="${b%.*}"
  b="${b#H__}"
  echo "$HOME/${b//__//}"
}

znajdz() {
  if [ -f "$1" ]; then echo "$1"; return 0; fi
  if [ -f "$K/$1" ]; then echo "$K/$1"; return 0; fi
  echo "Nie ma takiej kopii: $1" >&2
  return 1
}

case "${1:-}" in
  "")
    ls "$K" 2>/dev/null | sed 's/\.[0-9]\{8\}-[0-9]\{6\}$//' | sort | uniq -c | while read -r n b; do
      ostatnia=$(ls "$K" | grep -F "$b." | sort | tail -1)
      echo "$n kopii | ostatnia ${ostatnia##*.} | $(cel "$ostatnia")"
    done
    ;;
  diff)
    k=$(znajdz "${2:-}") || exit 1
    diff -u "$k" "$(cel "$k")" && echo "Bez różnic."
    ;;
  przywroc)
    k=$(znajdz "${2:-}") || exit 1
    c=$(cel "$k")
    b=$(basename "$k")
    if [ -f "$c" ]; then cp -p "$c" "$K/${b%.*}.$(date +%Y%m%d-%H%M%S)"; fi
    cp -p "$k" "$c" && echo "Przywrócono $c z $b"
    ;;
  *)
    ls "$K" 2>/dev/null | grep -i -- "$1" | while read -r f; do
      echo "$(stat -c '%y %s B' "$K/$f" | cut -c1-19,36-)  $f"
    done
    ;;
esac
