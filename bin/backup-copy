#!/usr/bin/env bash
# Automatyczne kopie plików konfiguracji opencode (robi je wtyczka auto-backup przed każdą zmianą).
#   backup-copy                  lista plików, które mają kopie (ile, ostatnia)
#   backup-copy FRAGMENT         kopie plików pasujących do fragmentu nazwy, np.: backup-copy AGENTS
#   backup-copy diff KOPIA       różnica: kopia → obecny plik
#   backup-copy restore KOPIA    przywraca plik z kopii (obecną wersję najpierw też zapisuje jako kopię)
# Zgodność wstecz: „przywroc” = restore.
set -u
BACKUP_DIR="$HOME/oc-audyt/auto-kopie"

# backup name: H__path__with__underscores.YYYYMMDD-HHMMSS → full path of the original
original_of() {
  local b
  b=$(basename "$1")
  b="${b%.*}"
  b="${b#H__}"
  echo "$HOME/${b//__//}"
}

find_backup() {
  if [ -f "$1" ]; then echo "$1"; return 0; fi
  if [ -f "$BACKUP_DIR/$1" ]; then echo "$BACKUP_DIR/$1"; return 0; fi
  echo "Nie ma takiej kopii: $1" >&2
  return 1
}

case "${1:-}" in
  "")
    ls "$BACKUP_DIR" 2>/dev/null | sed 's/\.[0-9]\{8\}-[0-9]\{6\}$//' | sort | uniq -c | while read -r n b; do
      latest=$(ls "$BACKUP_DIR" | grep -F "$b." | sort | tail -1)
      echo "$n kopii | ostatnia ${latest##*.} | $(original_of "$latest")"
    done
    ;;
  diff)
    k=$(find_backup "${2:-}") || exit 1
    diff -u "$k" "$(original_of "$k")" && echo "Bez różnic."
    ;;
  restore|przywroc)
    k=$(find_backup "${2:-}") || exit 1
    target=$(original_of "$k")
    b=$(basename "$k")
    if [ -f "$target" ]; then
      # same second as the chosen backup would overwrite it before it is restored
      while dst="$BACKUP_DIR/${b%.*}.$(date +%Y%m%d-%H%M%S)"; [ -e "$dst" ]; do sleep 1; done
      cp -p "$target" "$dst"
    fi
    cp -p "$k" "$target" && echo "Przywrócono $target z $b"
    ;;
  *)
    ls "$BACKUP_DIR" 2>/dev/null | grep -i -- "$1" | while read -r f; do
      echo "$(stat -c '%y %s B' "$BACKUP_DIR/$f" | cut -c1-19,36-)  $f"
    done
    ;;
esac
