#!/home/user/mempalace/.venv/bin/python
"""Kopalnia błędów i rozwiązań opencode: plik w ~/oc-audyt/kopalnia/ + wpis w OSOBNYM pałacu ~/.mempalace-opencode
(wing opencode, room bledy) — wnioski modeli nie mieszają się z osobistą pamięcią użytkownika w ~/.mempalace.

  oc-wniosek                                   ile wniosków i ostatnie 5
  oc-wniosek szukaj "komunikat albo słowa"     znane rozwiązania (dokładne słowa w plikach + podobne w mempalace)
  oc-wniosek dodaj "OBJAW" "PRZYCZYNA" "NAPRAWA" ["PRZYKŁAD poprawnego wywołania"]
        OBJAW     = komunikat błędu albo co się działo (dosłownie, krótko)
        PRZYCZYNA = dlaczego (jedno zdanie)
        NAPRAWA   = co zmieniono i gdzie (plik, reguła) albo jak to obejść
  oc-wniosek uzupelnij                         dopisz do mempalace wnioski, które są tylko w plikach

Zabezpieczenia: najwyżej 15 nowych wniosków dziennie; w trakcie miningu pałacu zapis idzie tylko do pliku
(potem `uzupelnij`); plik jest źródłem prawdy — przerwany zapis do pałacu niczego nie gubi.
"""
import datetime, os, re, sys, contextlib, io, sqlite3, subprocess

# Osobny pałac — musi być ustawiony PRZED importem mempalace.
os.environ["MEMPALACE_CONFIG_DIR"] = os.path.expanduser("~/.mempalace-opencode")
os.environ.pop("MEMPALACE_PALACE_PATH", None)
os.environ.pop("MEMPAL_PALACE_PATH", None)

KOPALNIA = os.path.expanduser("~/oc-audyt/kopalnia")
WING, ROOM = "opencode", "bledy"


def cicho(f, *a, **k):
    """mempalace wypisuje ostrzeżenia telemetrii na stderr — nie zaśmiecaj nimi wyniku"""
    with contextlib.redirect_stderr(io.StringIO()), contextlib.redirect_stdout(io.StringIO()):
        return f(*a, **k)


def pliki():
    os.makedirs(KOPALNIA, exist_ok=True)
    return sorted(f for f in os.listdir(KOPALNIA) if f.endswith(".md"))


def skrot(t, n=110):
    t = " ".join(t.split())
    return t if len(t) <= n else t[: n - 1] + "…"


LIMIT_DZIENNY = 15
PROG = 0.55  # minimalne podobieństwo dla trafienia samym znaczeniem (zmierzone: trafne 0,56–0,74, luźne ~0,50–0,53, obce ~0,3)
BAZA = os.path.expanduser("~/.mempalace-opencode/palace/chroma.sqlite3")


def trwa_mining():
    """Ciężki zapis do pałacu z innego procesu (mining) — wtedy nie dokładamy własnych zapisów."""
    try:
        r = subprocess.run(["pgrep", "-af", "mempalace mine|mine_case"], capture_output=True, text=True)
        return any("pgrep" not in l and "oc-wniosek" not in l for l in r.stdout.splitlines())
    except Exception:
        return False


def w_palacu():
    """Nazwy plików kopalni, które mają już wpis w mempalace (odczyt bazy tylko do odczytu)."""
    if not os.path.exists(BAZA):
        return set()  # pałac jeszcze nie założony — żaden wniosek nie ma wpisu
    try:
        db = sqlite3.connect(f"file:{BAZA}?mode=ro", uri=True)
        return {os.path.basename(r[0]) for r in db.execute(
            "select string_value from embedding_metadata where key='source_file' and string_value like '%oc-audyt/kopalnia%'")}
    except Exception:
        return None


def do_palacu(plik, tresc):
    if trwa_mining():
        return "trwa mining pałacu — wniosek tylko w pliku (później: oc-wniosek uzupelnij)"
    try:
        from mempalace import mcp_server as m
        r = cicho(m.tool_add_drawer, wing=WING, room=ROOM, content=tresc, added_by="oc-wniosek", source_file=plik)
        return "zapisano w pałacu opencode" if isinstance(r, dict) and r.get("success") else f"mempalace: {str(r)[:120]}"
    except Exception as e:  # plik i tak został — pałac można uzupełnić później
        return f"mempalace niedostępny ({type(e).__name__}); wniosek jest w pliku (później: oc-wniosek uzupelnij)"


def uzupelnij():
    ma = w_palacu()
    if ma is None:
        sys.exit("Nie mogę odczytać bazy pałacu.")
    brak = [f for f in pliki() if f not in ma]
    if not brak:
        print(f"Wszystkie wnioski ({len(pliki())}) są w mempalace.")
        return
    for f in brak:
        sciezka = os.path.join(KOPALNIA, f)
        print(f"{f[:60]} — {do_palacu(sciezka, open(sciezka, encoding='utf-8').read())}")


def dodaj(objaw, przyczyna, naprawa, przyklad=""):
    objaw, przyczyna, naprawa, przyklad = (" ".join(x.split()) for x in (objaw, przyczyna, naprawa, przyklad))
    if min(len(objaw), len(przyczyna), len(naprawa)) < 8:
        sys.exit("Każde z pól OBJAW, PRZYCZYNA, NAPRAWA musi mieć treść (min. 8 znaków).")
    for f in pliki():
        if objaw.lower() in open(os.path.join(KOPALNIA, f), encoding="utf-8").read().lower():
            print(f"Taki objaw już jest w kopalni: {f}")
            return
    dzis = datetime.date.today().isoformat()
    if os.environ.get("OC_WNIOSEK_ZASILANIE") != "1" and sum(1 for f in pliki() if f.startswith(dzis)) >= LIMIT_DZIENNY:
        sys.exit(f"Limit {LIMIT_DZIENNY} nowych wniosków dziennie wyczerpany. Dopisz jutro albo połącz podobne wnioski w jeden.")
    nazwa = re.sub(r"[^a-z0-9]+", "-", objaw.lower().translate(str.maketrans("ąćęłńóśźż", "acelnoszz")))[:50].strip("-") or "wniosek"
    plik = os.path.join(KOPALNIA, f"{dzis}-{nazwa}.md")
    tresc = f"# Błąd opencode i rozwiązanie ({dzis})\n\nOBJAW: {objaw}\nPRZYCZYNA: {przyczyna}\nNAPRAWA: {naprawa}\n"
    if przyklad:
        tresc += f"PRZYKŁAD: {przyklad}\n"
    with open(plik, "w", encoding="utf-8") as f:
        f.write(tresc)
    stan = do_palacu(plik, tresc)
    print(f"Dodano: {os.path.basename(plik)} — {stan}")


POSPOLITE = set("""nie jest jak przy albo oraz dla tego ten that the and model modelu narzedzie narzedzia blad bledu error
przez jako tylko gdy kiedy sie nad pod bez ale czy jego jej ich ma sa to na do od po za ze co""".split())


def bez_ogonkow(t):
    return t.lower().translate(str.maketrans("ąćęłńóśźż", "acelnoszz"))


def szukaj(q):
    """Wynik = wniosek, którego OBJAW zawiera większość istotnych słów zapytania ALBO jest znaczeniowo bliski (≥ PROG).
    Znaczeniowo szukamy TYLKO w pokoju błędów opencode — reszty pałacu (audio, sprzęt, prywatne notatki) nie pokazujemy."""
    slowa = [w for w in re.findall(r"\w+", bez_ogonkow(q)) if len(w) >= 4 and w not in POSPOLITE]
    wyniki = {}  # plik -> [udział słów w OBJAW, podobieństwo]
    for f in pliki():
        t = open(os.path.join(KOPALNIA, f), encoding="utf-8").read()
        objaw = bez_ogonkow(next((l for l in t.splitlines() if l.startswith("OBJAW: ")), ""))
        if slowa:
            udzial = sum(1 for w in slowa if w in objaw) / len(slowa)
            if udzial >= 0.6 and sum(1 for w in slowa if w in objaw) >= 2:
                wyniki[f] = [udzial, 0.0]
    try:
        from mempalace import mcp_server as m
        r = cicho(m.tool_search, q, limit=5, wing=WING, room=ROOM)
        for w in (r or {}).get("results") or []:
            sim = float(w.get("similarity") or 0)
            if w.get("room") != ROOM or sim < PROG:
                continue
            f = next((x for x in pliki() if x.startswith(str(w.get("source_file") or "\0")[:40])), None)
            if f:
                wyniki.setdefault(f, [0.0, 0.0])[1] = sim
    except Exception:
        pass
    if not wyniki:
        print("Brak znanych rozwiązań dla tego błędu — to nowy przypadek. Po naprawie dopisz go: oc-wniosek dodaj …")
        return
    kolejnosc = sorted(wyniki.items(), key=lambda kv: -(kv[1][0] + kv[1][1]))[:4]
    print(f"Znane rozwiązania ({len(kolejnosc)}) — sprawdź, czy OBJAW pasuje do Twojego błędu, zanim zastosujesz:")
    for f, (udzial, sim) in kolejnosc:
        t = open(os.path.join(KOPALNIA, f), encoding="utf-8").read()
        print(f"\n--- {f} (słowa {udzial:.0%}, podobieństwo {sim:.2f})")
        print("\n".join(l for l in t.splitlines() if l.startswith(("OBJAW", "PRZYCZYNA", "NAPRAWA", "PRZYKŁAD"))))


def main():
    a = sys.argv[1:]
    if not a:
        p = pliki()
        print(f"Wniosków w kopalni: {len(p)} (~/oc-audyt/kopalnia, pałac ~/.mempalace-opencode: {WING}/{ROOM})")
        for f in p[-5:]:
            t = open(os.path.join(KOPALNIA, f), encoding="utf-8").read()
            o = next((l[7:] for l in t.splitlines() if l.startswith("OBJAW: ")), "")
            print(f"- {f[:10]} {skrot(o)}")
    elif a[0] == "szukaj" and len(a) >= 2:
        szukaj(" ".join(a[1:]))
    elif a[0] == "uzupelnij":
        uzupelnij()
    elif a[0] == "dodaj" and len(a) in (4, 5):
        dodaj(*a[1:])
    else:
        print(__doc__)


main()
