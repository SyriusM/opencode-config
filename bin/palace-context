#!/home/user/mempalace/.venv/bin/python
"""Short mempalace context for a project directory — appended to the opencode system prompt
by the palace-context plugin. Prints ready text or nothing.

Usage: palace-context <directory> [--debug]
- Embedding server (PALACE_EMBED_PORT: 8080 llama.cpp, 11434 Ollama) or palace down → one warning line instead of silence
  (otherwise the model thinks the palace "knows nothing", while it is missing data, not a measurement).
- Home / generic directory → health check only, no search (a query without content = noise).
"""
import os
import socket
import sys
from pathlib import Path

THRESHOLD = 0.57          # minimum similarity (bge-m3); below that is noise
MAX_RESULTS = 3
MAX_CHARS = 350     # per result


def read_config() -> dict:
    """Optional $XDG_CONFIG_HOME/opencode-config/config, default ~/.config (KEY=VALUE, written by install.sh)."""
    k = {}
    try:
        for line in (Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "opencode-config" / "config").read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                a, b = line.split("=", 1)
                k[a.strip()] = b.strip().strip('"')
    except OSError:
        pass
    return k


K = read_config()
# embedding server port for the health check; 0/empty = no check (e.g. local chromadb embeddings)
PORT = int(K.get("PALACE_EMBED_PORT", "0") or 0)
# ONLY these wings (no diaries, chats or personal matters — the model has a browser and forms); "*" = all
_w = K.get("PALACE_WINGS", "*")
ALLOWED_WINGS = None if _w.strip() == "*" else {x.strip() for x in _w.split(",") if x.strip()}
MEMPALACE_SRC = os.path.expanduser(K.get("MEMPALACE_SRC", "~/mempalace"))
debug = "--debug" in sys.argv
args = [a for a in sys.argv[1:] if not a.startswith("--")]
directory = Path(args[0] if args else os.getcwd()).resolve()
home = Path.home()


def port_alive(port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=1):
            return True
    except OSError:
        return False


if PORT and not port_alive(PORT):
    print(f"PALACE: embeddings (:{PORT}) is not responding — mempalace_search will return nothing or an error. "
          "An empty result ≠ no knowledge; tell the user the palace is unavailable.")
    sys.exit(0)

if directory in (home, Path("/"), Path("/tmp")) or home not in directory.parents:
    sys.exit(0)

if os.path.isdir(os.path.join(MEMPALACE_SRC, "mempalace")):
    sys.path.insert(0, MEMPALACE_SRC)  # MemPalace sources (fork); without them — the pip package
# MemPalace from PyPI redirects fd 1 to stderr on import (MCP protocol protection) — keep the real stdout
_stdout_fd = os.dup(1)
sys.stdout, _out = open(os.devnull, "w"), sys.stdout  # mempalace prints telemetry
try:
    from mempalace import mcp_server as m
    rel = str(directory.relative_to(home))
    # English query: default chromadb embeddings are English-only; bge-m3 still matches Polish notes
    query = f"{directory.name} — project in ~/{rel}: status, decisions, problems"
    r = m.tool_search(query, limit=30)
    results = r.get("results", []) if isinstance(r, dict) else []
except Exception as e:  # noqa: BLE001
    sys.stdout = _out
    os.write(_stdout_fd, f"PALACE: search failed ({type(e).__name__}) — the palace may be unavailable.\n".encode())
    sys.exit(0)
sys.stdout = _out

def is_noise(w: dict) -> bool:
    # entities.json matches everything; raw transcripts (.jsonl) are conversation, not facts
    source = str(w.get("source_file", ""))
    text = str(w.get("text", "")).strip()
    if (ALLOWED_WINGS is not None and w.get("wing") not in ALLOWED_WINGS) or "diary" in str(w.get("room", "")):
        return True
    return (source == "entities.json" or source.endswith(".jsonl") or w.get("wing") == "_quarantine"
            or len(text) < 80 or text.startswith("[tool:"))


selected = [w for w in results if w.get("similarity", 0) >= THRESHOLD and not is_noise(w)][:MAX_RESULTS]
if debug:
    for w in results:
        print(f"# {w.get('similarity')} {w.get('wing')}/{w.get('room')} {w.get('topic')}", file=sys.stderr)
if not selected:
    sys.exit(0)

lines = [f"PALACE (memory background for ~/{rel}; these are notes from the past — check the current state before basing a decision on them; "
         "more: mempalace_search):"]
for w in selected:
    text = " ".join(str(w.get("text", "")).split())
    if len(text) > MAX_CHARS:
        text = text[:MAX_CHARS].rsplit(" ", 1)[0] + " …"
    lines.append(f"- [{w.get('wing')}/{w.get('room')}] {text}")
os.write(_stdout_fd, ("\n".join(lines) + "\n").encode())
