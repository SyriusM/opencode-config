#!/usr/bin/env bash
# Retencja ~/mempalace/audit: pliki *.jsonl starsze niż 30 dni (także w podkatalogach kategorii)
# → ~/mempalace/audit-archive/audit-<data>.tar.gz, weryfikacja bajt w bajt, dopiero potem kasowanie.
# Przenoś, nie kasuj: bez udanej weryfikacji nic nie znika.
set -euo pipefail
AUDIT="$HOME/mempalace/audit"
ARCHIVE="$HOME/mempalace/audit-archive"
DAYS="${1:-30}"
mkdir -p "$ARCHIVE"
mapfile -t FILES < <(cd "$AUDIT" && find . -type f -name '*.jsonl' -mtime +"$DAYS" | sort)
if [ "${#FILES[@]}" -eq 0 ]; then echo "audit-retention: nothing older than $DAYS days"; exit 0; fi
TAR="$ARCHIVE/audit-$(date +%Y%m%d-%H%M%S).tar.gz"
tar -C "$AUDIT" -czf "$TAR" "${FILES[@]}"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
tar -C "$TMP" -xzf "$TAR"
for f in "${FILES[@]}"; do
  cmp -s "$AUDIT/$f" "$TMP/$f" || { echo "audit-retention: MISMATCH in $f — nothing deleted, archive $TAR kept"; exit 1; }
done
for f in "${FILES[@]}"; do rm -f "$AUDIT/$f"; done
echo "audit-retention: ${#FILES[@]} files → $TAR (verified)"
