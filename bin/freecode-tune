#!/usr/bin/env python3
"""freecode-tune — tuning a llama.cpp server (systemd --user service): try → measure → keep or roll back.

  freecode-tune units                     services running llama-server that can be tuned
  freecode-tune [-u UNIT] status          state: current flags, allowed changes, baseline score, recent tries
  freecode-tune [-u UNIT] bench           measure the current settings and save them as the baseline (GOOD)
  freecode-tune [-u UNIT] try KEY=VALUE…  change flags, restart, measure; better = kept, worse = rolled back
  freecode-tune [-u UNIT] rollback        remove the tuning changes (back to ExecStart from the unit and its drop-ins)
  freecode-tune [-u UNIT] rebase          move the tuning onto a baseline changed by hand after tuning

UNIT by default: FREECODE_TUNE_UNIT, then freecode-llama.service (from bootstrap.sh) if it exists, otherwise
the main model's service (port from `model` in opencode.json → NAME-proxy.socket or `--port` in the unit); `-u llama-qwen36` also works. A service started
on demand through the NAME-proxy.socket socket is woken through that socket, any other is restarted directly.

Only flags from the allow-list (KNOBS below) can be changed, within their ranges — also when the command comes
from an AI model. Changes go to a separate drop-in `UNIT.d/tune.conf` (read last); the unit and its
other drop-ins stay untouched, and arguments outside the list (with %h, quotes) pass through verbatim.
So a guard that moves tune.conf aside after a failure restores the settings from before tuning.
tune.conf has the full ExecStart line, so it covers later manual changes in the unit/drop-ins — that is why
it remembers the baseline (`# base:`); status warns, bench/try refuse, and `rebase` applies the tuned flags to the new baseline.
History of tries: ~/.local/share/freecode/tune-history.jsonl.

Measurement (on the running server, with the same memory layout as in real work): chat, code rewriting
(where ngram speculation works) and a long prompt (read speed + whether memory runs out). Short tests
twice (the better one counts), the long prompt once. Score = geometric mean of the three speeds; a change stays when the score
rises by ≥ 3% (measurement noise) — or when a larger context loses no more than 3%.

Variables: FREECODE_TUNE_UNIT (like -u), FREECODE_TUNE_SOCKET (socket instead of NAME-proxy.socket, empty = none).
"""
import json
import math
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
import base64
import fcntl
import struct
import zlib

CFG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "freecode")
UNITS = os.path.join(CFG, "systemd", "user")
UNIT = SOCKET = PROXY = DROPIN = STATE = ""


def select_unit(name):
    global UNIT, SOCKET, PROXY, DROPIN, STATE
    UNIT = name if name.endswith(".service") else name + ".service"
    stem = UNIT[:-len(".service")]
    SOCKET = os.environ.get("FREECODE_TUNE_SOCKET", stem + "-proxy.socket")
    PROXY = SOCKET.replace(".socket", ".service")
    DROPIN = os.path.join(UNITS, UNIT + ".d", "tune.conf")
    STATE = os.path.join(DATA, f"tune-state-{stem}.json")


def main_model_port():
    """Port of the main model (`model` → provider → baseURL) from the global opencode config; None = unknown."""
    d = os.environ.get("OPENCODE_CONFIG_DIR") or os.path.join(CFG, "opencode")
    for name in ("opencode.json", "opencode.jsonc"):
        try:
            c = json.load(open(os.path.join(d, name), encoding="utf-8"))
            prov = c["model"].split("/", 1)[0]
            m = re.search(r":(\d+)(/|$)", c["provider"][prov]["options"]["baseURL"])
            return int(m.group(1)) if m else None
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
    return None


def default_unit():
    """Unit without -u: FREECODE_TUNE_UNIT, freecode-llama.service from bootstrap, otherwise the main model's service."""
    if os.environ.get("FREECODE_TUNE_UNIT"):
        return os.environ["FREECODE_TUNE_UNIT"]
    if os.path.exists(os.path.join(UNITS, "freecode-llama.service")):
        return "freecode-llama.service"
    port = main_model_port()
    if port and os.path.isdir(UNITS):
        for f in sorted(os.listdir(UNITS)):   # on-demand socket: NAME-proxy.socket listens on the model port
            if f.endswith("-proxy.socket"):
                try:
                    txt = open(os.path.join(UNITS, f), encoding="utf-8").read()
                except OSError:
                    continue
                unit = f[:-len("-proxy.socket")] + ".service"
                if re.search(rf"^ListenStream=(\S*:)?{port}\s*$", txt, re.M) and os.path.exists(os.path.join(UNITS, unit)):
                    return unit
        for f in sorted(os.listdir(UNITS)):   # service without a socket: llama-server with --port equal to the model port
            if f.endswith(".service") and "@" not in f:
                try:
                    txt = open(os.path.join(UNITS, f), encoding="utf-8").read()
                except OSError:
                    continue
                if re.search(rf"^ExecStart=\S*llama-server\b.*\s--port[= ]{port}\b", txt, re.M):
                    return f
    return "freecode-llama.service"


select_unit("freecode-llama.service")
HISTORY = os.path.join(DATA, "tune-history.jsonl")
REPORT = os.path.join(DATA, "tune-report.json")

KEEP_GAIN = 1.03      # below 3% is measurement noise (two tries of the same configuration differ by 1–2%)
CTX_TOLERANCE = 0.97  # a larger context may cost up to 3% speed
STALL_LIMIT = 10      # % of time waiting for memory (PSI full) — above it the test measures lack of RAM, not the settings
LOAD_TIMEOUT = 900

# Allow-list: key → (llama-server flags it sets/replaces, type, range or values, description).
# The range protects against settings that would take down the server or the session the AI model runs in.
KNOBS = {
    "ctx":        (["-c", "--ctx-size"], int, (16384, 262144), "context window in tokens (multiple of 1024)"),
    "moe-cache":  (["--moe-cache-mib"], int, (0, 32000), "MiB of VRAM for the MoE expert cache (only with --cpu-moe)"),
    "n-cpu-moe":  (["-ncmoe", "--n-cpu-moe"], int, (0, 99), "experts of the first N layers in RAM instead of --cpu-moe (off = --cpu-moe)"),
    "spec":       (["--spec-type"], str, ("ngram-mod", "ngram-simple", "none"), "speculation without a draft model"),
    "threads":    (["-t", "--threads"], int, (1, os.cpu_count() or 1), "CPU threads for generation"),
    "ubatch":     (["-ub", "--ubatch-size"], int, (128, 4096), "physical prompt batch (read speed, VRAM)"),
    "batch":      (["-b", "--batch-size"], int, (128, 8192), "logiczna paczka promptu (≥ ubatch)"),
    "cache-ram":  (["--cache-ram"], int, (0, 16384), "MiB of RAM for the prompt cache (too much pushes the weights out of RAM)"),
}
FLAG_ARITY = {"--cpu-moe": 0, "--no-host": 0, "--jinja": 0, "--no-mmap": 0, "--mlock": 0}


def die(msg, code=1):
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(code)


# ── unit i drop-in ──────────────────────────────────────────────────────────────────────────────
def systemd_split(line):
    """ExecStart= → arguments in VERBATIM form (quotes, %h, $$, \\ stay), so that writing them back
    gives systemd exactly the same thing. We compare only flag names and allow-list values (plain numbers)."""
    tokens, cur, quote, i = [], "", None, 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur += line[i:i + 2]; i += 2; continue
        if quote:
            quote = None if c == quote else quote
            cur += c
        elif c in "\"'":
            quote = c; cur += c
        elif c.isspace():
            if cur:
                tokens.append(cur); cur = ""
        else:
            cur += c
        i += 1
    if cur:
        tokens.append(cur)
    return tokens


def systemd_join(args):
    return " ".join(args)


def exec_start(paths):
    """The effective ExecStart= in order from the unit and drop-ins (an empty ExecStart= line resets, as in systemd)."""
    found = None
    for path in paths:
        if not os.path.exists(path):
            continue
        text = re.sub(r"\\\n", " ", open(path, encoding="utf-8").read())   # kontynuacje linii
        for line in text.splitlines():
            if line.startswith("ExecStart="):
                value = line[len("ExecStart="):].strip()
                found = systemd_split(value) if value else None
    return found


def unit_files(with_tune):
    d = os.path.join(UNITS, UNIT + ".d")
    drops = sorted(f for f in os.listdir(d) if f.endswith(".conf")) if os.path.isdir(d) else []
    return [os.path.join(UNITS, UNIT)] + [os.path.join(d, f) for f in drops if with_tune or f != "tune.conf"]


def base_args():
    late = [f for f in unit_files(False)[1:] if os.path.basename(f) > "tune.conf" and exec_start([f])]
    if late:   # a drop-in read after tune.conf would override the tuning changes — tries would measure something else
        die(f"{late[0]} sets ExecStart= and is read after tune.conf — rename it (e.g. to 50-…conf)")
    args = exec_start(unit_files(False))
    if not args:
        die(f"no {UNITS}/{UNIT} with ExecStart= (list of tunable services: freecode-tune units)")
    if not re.search(r"llama-server$", args[0].strip("\"'")):
        die(f"{UNIT} does not run llama-server — tuning supports llama.cpp only")
    return args


def current_args():
    return exec_start(unit_files(True)) or base_args()


def to_options(args):
    """[program, -m, x, --cpu-moe, ...] → (program, [(flag, value|None), ...])."""
    prog, rest, opts, i = args[0], args[1:], [], 0
    while i < len(rest):
        flag = rest[i]
        takes = FLAG_ARITY.get(flag, 1)
        if takes and i + 1 < len(rest) and not (rest[i + 1].startswith("-") and not re.fullmatch(r"-\d+", rest[i + 1])):
            opts.append((flag, rest[i + 1])); i += 2
        else:
            opts.append((flag, None)); i += 1
    return prog, opts


def from_options(prog, opts):
    out = [prog]
    for flag, value in opts:
        out.append(flag)
        if value is not None:
            out.append(value)
    return out


def get(opts, flags):
    for flag, value in opts:
        if flag in flags:
            return value if value is not None else True
    return None


def knob_values(opts):
    vals = {}
    for key, (flags, *_rest) in KNOBS.items():
        v = get(opts, flags)
        if v is not None:
            vals[key] = v
    if get(opts, ["--cpu-moe"]):
        vals.setdefault("n-cpu-moe", "off (--cpu-moe)")
    return vals


def parse_change(text):
    if "=" not in text:
        die(f"\"{text}\": use KEY=VALUE, e.g. ctx=49152 (keys: {', '.join(KNOBS)})", 2)
    key, raw = text.split("=", 1)
    if key not in KNOBS:
        die(f"\"{key}\" is not on the allow-list (allowed: {', '.join(KNOBS)})", 2)
    flags, kind, allowed, _ = KNOBS[key]
    if key == "n-cpu-moe" and raw == "off":
        return key, None
    if kind is int:
        if not re.fullmatch(r"\d+", raw):
            die(f"{key}: an integer, got \"{raw}\"", 2)
        value = int(raw)
        lo, hi = allowed
        if not lo <= value <= hi:
            die(f"{key}={value} poza zakresem {lo}–{hi}", 2)
        if key == "ctx" and value % 1024:
            die("ctx: a multiple of 1024", 2)
        return key, str(value)
    if raw not in allowed:
        die(f"{key}: one of {', '.join(allowed)}", 2)
    return key, raw


def apply_changes(opts, changes):
    opts = list(opts)
    for key, value in changes:
        flags = KNOBS[key][0]
        if key == "moe-cache" and not get(opts, ["--cpu-moe"]):
            die("moe-cache works only with --cpu-moe (first n-cpu-moe=off)", 2)
        if key == "n-cpu-moe":
            if value is None:   # off → all experts in RAM + cache on the GPU
                opts = [o for o in opts if o[0] not in flags]
                if not get(opts, ["--cpu-moe"]):
                    opts.append(("--cpu-moe", None))
                continue
            # the expert cache exists only in --cpu-moe mode
            opts = [o for o in opts if o[0] not in ("--cpu-moe", "--moe-cache-mib")]
        replaced = False
        for i, (flag, _old) in enumerate(opts):
            if flag in flags:
                opts[i] = (flag, value); replaced = True
        if not replaced:
            opts.append((flags[0], value))
    batch, ubatch = get(opts, KNOBS["batch"][0]), get(opts, KNOBS["ubatch"][0])
    if batch and ubatch and int(batch) < int(ubatch):
        die(f"batch ({batch}) smaller than ubatch ({ubatch})", 2)
    return opts


def write_dropin(args):
    os.makedirs(os.path.dirname(DROPIN), exist_ok=True)
    tmp = DROPIN + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(f"# freecode-tune: tuned flags (rollback = freecode-tune -u {UNIT} rollback)\n"
                "# a manual flag change in the unit/drop-ins has no effect while this file exists — then: freecode-tune rebase\n"
                f"# base: {systemd_join(base_args())}\n"
                f"[Service]\nExecStart=\nExecStart={systemd_join(args)}\n")
    os.replace(tmp, DROPIN)


def recorded_base():
    try:
        for line in open(DROPIN, encoding="utf-8"):
            if line.startswith("# base: "):
                return systemd_split(line[len("# base: "):].strip())
    except OSError:
        pass
    return None


def drifted():
    """The baseline saved in tune.conf, if someone changed the unit/drop-ins after tuning (tune.conf covers it)."""
    old = recorded_base()
    return old if old is not None and old != base_args() else None


def ensure_no_drift():
    if drifted():
        die(f"unit flags changed by hand after tuning, and {DROPIN} covers them — "
            f"freecode-tune -u {UNIT} rebase (tuning on the new baseline) or rollback (no tuning)", 5)


def set_args(args):
    if args == base_args():
        if os.path.exists(DROPIN):
            os.remove(DROPIN)
    else:
        write_dropin(args)
    systemctl("daemon-reload")


# ── server ──────────────────────────────────────────────────────────────────────────────────────
def systemctl(*args, check=True):
    r = subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)
    if check and r.returncode:
        die(f"systemctl --user {' '.join(args)}: {r.stderr.strip()}")
    return r


def server_port(args):
    _, opts = to_options(args)
    return int(get(opts, ["--port"]) or 8080)


def http(port, path, body=None, timeout=600):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}",
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read() or b"null")


def busy(port):
    """True = the server is busy (e.g. another session) — a restart would interrupt someone's work."""
    try:
        slots = http(port, "/slots", timeout=3)
    except (OSError, ValueError, urllib.error.URLError):
        return False   # not running or /slots disabled
    return any(s.get("is_processing") for s in slots or [])


def socket_port():
    path = os.path.join(UNITS, SOCKET)
    if not SOCKET or not os.path.exists(path):
        return None
    m = re.search(r"^ListenStream=(?:.*:)?(\d+)\s*$", open(path, encoding="utf-8").read(), re.M)
    return int(m.group(1)) if m else None


def running_matches(args):
    """Whether the running process has exactly these flags — we measure what we try, not something substituted."""
    r = systemctl("show", "-p", "MainPID", "--value", UNIT, check=False)
    pid = (getattr(r, "stdout", "") or "").strip()
    if not pid:
        return True   # cannot check (e.g. tests) — do not block
    if pid == "0":
        return False  # unit without a process, yet the port answers — not our server
    try:
        got = open(f"/proc/{pid}/cmdline", "rb").read().decode().split("\0")[:-1]
    except (OSError, ValueError):
        return True   # cannot check (e.g. tests) — do not block
    want = [systemd_unquote(a).replace("%h", os.path.expanduser("~")).replace("$$", "$") for a in args]
    return got == want


def systemd_unquote(tok):
    """A verbatim ExecStart= token → the argument the process gets: quotes removed, backslash escapes
    resolved (11-21: `"{\\"preserve_thinking\\":true}"` and `token_embd\\\\.weight` never matched, so bench refused)."""
    out, quote, i = "", None, 0
    while i < len(tok):
        c = tok[i]
        if c == "\\" and i + 1 < len(tok):
            out += {"n": "\n", "t": "\t"}.get(tok[i + 1], tok[i + 1]); i += 2; continue
        if quote:
            if c == quote:
                quote = None
            else:
                out += c
        elif c in "\"'":
            quote = c
        else:
            out += c
        i += 1
    return out


def wait_stopped():
    """A hung start (ExecStartPost waiting for /health) can cancel a stop — retry until the unit is down,
    otherwise we would mistake its "start-post without a process" state for a crash of the new server."""
    for _ in range(30):
        show = systemctl("show", "-p", "ActiveState", UNIT, check=False)
        state = (getattr(show, "stdout", "") or "").strip()
        if not state or state in ("ActiveState=inactive", "ActiveState=failed"):
            return
        systemctl("stop", UNIT, check=False)
        time.sleep(1)


def restart(args):
    """Restart with new flags; returns (ok, last log lines)."""
    started = time.strftime("%Y-%m-%d %H:%M:%S")
    sport = socket_port()
    if sport:
        # StopWhenUnneeded: the unit alone without the proxy would stop right away — a request through the socket wakes both
        systemctl("stop", PROXY, UNIT, check=False)
        wait_stopped()
        # after a series of failed starts the socket stays "failed" (trigger-limit-hit) and accepts no connections
        systemctl("reset-failed", SOCKET, PROXY, UNIT, check=False)
        systemctl("start", SOCKET, check=False)
        wake = sport
    else:
        systemctl("stop", UNIT, check=False)
        wait_stopped()
        systemctl("reset-failed", UNIT, check=False)
        systemctl("start", "--no-block", UNIT, check=False)
        wake = server_port(args)
    deadline = time.time() + LOAD_TIMEOUT
    while time.time() < deadline:
        try:
            http(wake, "/health", timeout=10)
            if not running_matches(args):
                return False, "the server runs with different flags than the try (the guard or a manual unit change)"
            return True, ""
        except (OSError, ValueError, urllib.error.URLError):
            # Restart=on-failure: a crashed server cycles in auto-restart, it is never permanently "failed"
            show = systemctl("show", "-p", "ActiveState,SubState,MainPID", UNIT, check=False).stdout
            if "SubState=auto-restart" in show or "ActiveState=failed" in show:
                break
            # the server crashed, and ExecStartPost (waiting for /health) still holds the unit in start — otherwise
            # we would wait minutes until OnFailure= (the guard) puts the old flags back and we measure the wrong thing
            if "SubState=start-post" in show and "MainPID=0" in show:
                break
            if sport and "ActiveState=active" not in systemctl("show", "-p", "ActiveState", SOCKET, check=False).stdout:
                break   # the socket died — waiting longer won't help
            time.sleep(2)
    log = subprocess.run(["journalctl", "--user", "-u", UNIT, "--since", started, "--no-pager", "-o", "cat"],
                         capture_output=True, text=True).stdout.strip().splitlines()
    return False, "\n".join(log[-12:])


# ── measurement ──────────────────────────────────────────────────────────────────────────────────────
CODE = '''def merge_intervals(intervals):
    """Merge overlapping [start, end] intervals."""
    if not intervals:
        return []
    intervals.sort(key=lambda x: x[0])
    merged = [list(intervals[0])]
    for start, end in intervals[1:]:
        if start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return merged


class LRUCache:
    def __init__(self, capacity):
        self.capacity = capacity
        self.items = {}
        self.order = []

    def get(self, key):
        if key not in self.items:
            return None
        self.order.remove(key)
        self.order.append(key)
        return self.items[key]

    def put(self, key, value):
        if key in self.items:
            self.order.remove(key)
        elif len(self.items) >= self.capacity:
            oldest = self.order.pop(0)
            del self.items[oldest]
        self.items[key] = value
        self.order.append(key)
'''


def psi_full():
    try:
        m = re.search(r"^full .*total=(\d+)", open("/proc/pressure/memory").read(), re.M)
        return int(m.group(1)) if m else 0
    except OSError:
        return 0


def completion(port, prompt, n_predict):
    r = http(port, "/completion", {"prompt": prompt, "n_predict": n_predict, "cache_prompt": False,
                                   "temperature": 0, "seed": 1, "ignore_eos": True}, timeout=LOAD_TIMEOUT)
    return r["timings"]


def long_prompt(port, ctx):
    """Prompt ~60% of the window (max 40k tokens) — what a typical opencode session with project context has."""
    target = min(int(ctx * 0.6), 40000)
    unit = CODE + "\n"
    n_unit = len(http(port, "/tokenize", {"content": unit})["tokens"])
    parts = [f"# file {i}\n{unit.replace('merge_intervals', f'merge_{i}')}" for i in range(target // n_unit)]
    return "".join(parts) + "\nSummarize the code above in one sentence."


def test_png(w=1024, h=768):
    """A gradient PNG without libraries — a realistically sized image, so the server allocates buffers as for a screenshot."""
    rows = b"".join(b"\0" + bytes(v for x in range(w) for v in (x * 255 // w, y * 255 // h, (x + y) % 256)) for y in range(h))
    chunk = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(rows, 6)) + chunk(b"IEND", b""))


def image_check(port):
    """A model with --mmproj: an image needs extra VRAM (measured: 9B at ctx 128k crashed on the first
    image, 248 MiB short). A text-only test would not catch it."""
    url = "data:image/png;base64," + base64.b64encode(test_png()).decode()
    r = http(port, "/v1/chat/completions", {"max_tokens": 8, "messages": [{"role": "user", "content": [
        {"type": "text", "text": "What colors are in this image? One word."},
        {"type": "image_url", "image_url": {"url": url}}]}]}, timeout=LOAD_TIMEOUT)
    return r["choices"][0]["message"] is not None


def measure(args):
    port = server_port(args)
    _, opts = to_options(args)
    ctx = int(get(opts, KNOBS["ctx"][0]) or 4096)
    tests = {
        "chat": ("Explain in detail how a hash map handles collisions, with examples.\n\n", 128, "predicted_per_second"),
        "code": (CODE + "\nRepeat the code above exactly, without changes:\n\n", 256, "predicted_per_second"),
        "prompt": (long_prompt(port, ctx), 8, "prompt_per_second"),
    }
    result, p0, t0 = {}, psi_full(), time.monotonic()
    completion(port, "Hello", 4)   # warm-up: the first request after start pays for initialization
    for name, (prompt, n, field) in tests.items():
        best = 0.0
        for _ in range(1 if name == "prompt" else 2):   # the long prompt is stable, and on CPU it takes minutes
            try:
                best = max(best, completion(port, prompt, n)[field])
            except (OSError, KeyError, ValueError, urllib.error.URLError) as e:
                return {"error": f"{name}: {e}"}
        result[name] = round(best, 1)
    if get(opts, ["--mmproj", "-mm"]):
        try:
            image_check(port)
            http(port, "/health", timeout=10)   # the server is still alive after the image
            result["image"] = "ok"
        except (OSError, KeyError, ValueError, urllib.error.URLError) as e:
            return {"error": f"image (--mmproj): {e}"}
    result["prompt_tokens"] = len(http(port, "/tokenize", {"content": tests["prompt"][0]})["tokens"])
    result["mem_stall_pct"] = round((psi_full() - p0) / 1e4 / (time.monotonic() - t0), 1)   # µs → % czasu
    result["score"] = round(math.prod(result[k] for k in ("chat", "code", "prompt")) ** (1 / 3), 1)
    return result


# ── state ────────────────────────────────────────────────────────────────────────────────────────
def load_state():
    try:
        return json.load(open(STATE, encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(DATA, exist_ok=True)
    json.dump(state, open(STATE, "w", encoding="utf-8"), indent=1, ensure_ascii=False)


def log_history(entry):
    os.makedirs(DATA, exist_ok=True)
    with open(HISTORY, "a", encoding="utf-8") as f:
        f.write(json.dumps({"date": time.strftime("%F %T"), "unit": UNIT, **entry}, ensure_ascii=False) + "\n")


def fmt(m):
    if "error" in m:
        return f"ERROR {m['error']}"
    return (f"score {m['score']} (chat {m['chat']}, code {m['code']}, prompt {m['prompt']} tok/s "
            f"at {m['prompt_tokens']} tokens; {'image ok; ' if m.get('image') else ''}"
            f"memory wait {m['mem_stall_pct']}%)")


def ensure_idle(args):
    if busy(server_port(args)):
        die("the server is busy (someone's session is running) — try when it finishes", 3)


def cmd_bench():
    ensure_no_drift()
    args = current_args()
    ensure_idle(args)
    ok, log = restart(args)   # a fresh start = the same conditions as after every try
    if not ok:
        die(f"the server does not start with the current settings:\n{log}")
    m = measure(args)
    print(fmt(m))
    if "error" in m or m["mem_stall_pct"] >= STALL_LIMIT:
        die("measurement invalid — close big programs and repeat", 4)
    save_state({"good_args": args, "good": m})
    log_history({"action": "bench", "args": args, "result": m})
    print(f"✓ saved as the baseline (GOOD) in {STATE}")


def cmd_try(texts):
    state = load_state()
    if not state.get("good"):
        die("no baseline — first: freecode-tune bench", 2)
    ensure_no_drift()
    changes = [parse_change(t) for t in texts]
    good_args = state["good_args"]
    if good_args != current_args():
        # 11-21: a baseline from 10-22 (ctx 65536, no KV q4_0) was silently used as the base of a try
        die(f"the baseline (GOOD) was measured on other flags than {UNIT} has now — "
            f"first: freecode-tune -u {UNIT} bench", 5)
    prog, opts = to_options(good_args)
    new_args = from_options(prog, apply_changes(opts, changes))
    if new_args == good_args:
        die("these values are already set — nothing to test", 2)
    ensure_idle(good_args)
    label = " ".join(texts)
    print(f"try: {label}")
    set_args(new_args)
    up, log = restart(new_args)
    m = measure(new_args) if up else {"error": "the server did not start:\n" + log}
    good = state["good"]
    old_ctx = int(get(opts, KNOBS["ctx"][0]) or 0)
    new_ctx = int(get(to_options(new_args)[1], KNOBS["ctx"][0]) or 0)
    need = CTX_TOLERANCE if new_ctx > old_ctx else KEEP_GAIN
    if "error" in m:
        verdict, why = "rolled back", m["error"]
    elif m["mem_stall_pct"] >= STALL_LIMIT:
        verdict, why = "rolled back", f"measurement disturbed by lack of RAM ({m['mem_stall_pct']}% waiting) — repeat after closing programs"
    elif m["score"] >= good["score"] * need:
        verdict, why = "kept", f"score {good['score']} → {m['score']} ({m['score'] / good['score'] - 1:+.1%})"
    else:
        verdict, why = "rolled back", (f"score {good['score']} → {m['score']} ({m['score'] / good['score'] - 1:+.1%}, "
                                   f"needed ≥ {need - 1:+.0%})")
    if "error" not in m:
        print(fmt(m))
    if verdict == "kept":
        save_state({"good_args": new_args, "good": m})
    else:
        set_args(good_args)
        back, log = restart(good_args)
        if not back:
            die(f"WARNING: after the rollback the server did not start — freecode-tune rollback\n{log}")
    log_history({"action": "try", "change": label, "verdict": verdict, "why": why, "result": m,
                 "before": good["score"]})
    print(f"{'✓' if verdict == 'kept' else '↩'} {verdict}: {why}")


def cmd_rollback():
    args = base_args()
    ensure_idle(current_args())
    set_args(args)
    save_state({})   # a baseline measured on tuned flags no longer applies — also when the start below fails
    log_history({"action": "rollback", "args": args})
    ok, log = restart(args)
    if not ok:
        die(f"the server does not start even with the bootstrap settings:\n{log}")
    print("✓ pre-tuning settings restored; baseline cleared — before further tries: freecode-tune bench")


def cmd_rebase():
    old = drifted()
    if not old:
        print("baseline unchanged since tuning — nothing to do"); return
    _, old_opts = to_options(old)
    _, tuned_opts = to_options(current_args())
    prog, opts = to_options(base_args())
    changes, dropped = [], []
    for key, (flags, *_rest) in KNOBS.items():
        was, now = get(old_opts, flags), get(tuned_opts, flags)
        if was == now:
            continue
        if now is not None:
            changes.append((key, now))
        elif key == "n-cpu-moe":
            changes.append((key, None))
        else:
            dropped.append(flags)
    changes.sort(key=lambda c: c[0] != "n-cpu-moe")   # MoE mode first, because moe-cache needs --cpu-moe
    for flags in dropped:   # tuning removed a flag (rare) — remove it from the new baseline too
        opts = [o for o in opts if o[0] not in flags]
    new = from_options(prog, apply_changes(opts, changes))
    set_args(new)
    save_state({})   # the old score measured other flags
    log_history({"action": "rebase", "args": new, "changes": [f"{k}={'off' if v is None else v}" for k, v in changes]})
    print("tuned changes on the new baseline: " + (", ".join(f"{k}={'off' if v is None else v}" for k, v in changes) or "none"))
    print(f"✓ saved; takes effect at the next server start. Before further tries: freecode-tune -u {UNIT} bench")


def cmd_status():
    args = current_args()
    _, opts = to_options(args)
    state = load_state()
    print(f"unit: {UNIT}{' + tuning changes (' + DROPIN + ')' if os.path.exists(DROPIN) else ' (no tuning changes)'}")
    print("flags: " + " ".join(args[1:]))
    if drifted():
        print(f"! unit flags changed by hand after tuning — they do NOT apply, tune.conf covers them; "
              f"fix: freecode-tune -u {UNIT} rebase")
    d = os.path.dirname(DROPIN)
    for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if f.startswith("tune.conf.failed-"):
            print(f"! the guard moved the tuning changes aside after a failure: {os.path.join(d, f)}")
    vals = knob_values(opts)
    print("\nallow-list (key = now; range — description):")
    for key, (_flags, kind, allowed, desc) in KNOBS.items():
        span = f"{allowed[0]}–{allowed[1]}" if kind is int else "|".join(allowed)
        print(f"  {key} = {vals.get(key, '(llama.cpp default)')};  {span} — {desc}")
    print("\nbaseline (GOOD): " + (fmt(state["good"]) if state.get("good") else "none — run: freecode-tune bench"))
    try:
        hist = [h for h in map(json.loads, open(HISTORY, encoding="utf-8")) if h.get("unit", UNIT) == UNIT][-10:]
    except OSError:
        hist = []
    if hist:
        print("\nrecent tries:")
        for h in hist:
            if h["action"] == "try":
                print(f"  {h['date']}  {h['change']}: {h['verdict']} — {h['why'].splitlines()[0]}")
            else:
                print(f"  {h['date']}  {h['action']}")
    if os.path.exists(REPORT) and UNIT == "freecode-llama.service":
        r = json.load(open(REPORT, encoding="utf-8"))
        print(f"\nbootstrap calibration ({r.get('date')}): chosen {r.get('chosen')}; "
              + ", ".join(f"{c['device']} {c['tok_s']} tok/s" for c in r.get("candidates", [])))


def cmd_units():
    if not os.path.isdir(UNITS):
        die(f"no {UNITS}")
    for f in sorted(os.listdir(UNITS)):
        if not f.endswith(".service") or "@" in f:
            continue
        select_unit(f)
        args = exec_start(unit_files(True))
        if args and re.search(r"llama-server$", args[0].strip("\"'")):
            _, opts = to_options(args)
            model = os.path.basename(str(get(opts, ["-m", "--model"]) or "?"))
            mode = "on demand via " + SOCKET if os.path.exists(os.path.join(UNITS, SOCKET)) else "started directly"
            print(f"  {f[:-len('.service')]:24} {model}  ({mode}{', tuned' if os.path.exists(DROPIN) else ''})")


def take_lock():
    """One tuning at a time for the whole computer — the services share the GPU (Conflicts=), parallel measurements break."""
    os.makedirs(DATA, exist_ok=True)
    global _lock
    _lock = open(os.path.join(DATA, "tune.lock"), "w")
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        die("another tuning (freecode-tune) is running — wait until it finishes", 3)


def main(argv):
    if argv[:1] in (["-u"], ["--unit"]):
        if len(argv) < 2:
            die("-u SERVICE_NAME", 2)
        select_unit(argv[1]); argv = argv[2:]
    elif argv[:1] != ["units"]:
        select_unit(default_unit())
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip()); return
    cmd, rest = argv[0], argv[1:]
    if cmd in ("bench", "try", "rollback", "rebase"):
        take_lock()
    if cmd == "units": cmd_units()
    elif cmd == "status": cmd_status()
    elif cmd == "bench": cmd_bench()
    elif cmd == "try" and rest: cmd_try(rest)
    elif cmd == "rollback": cmd_rollback()
    elif cmd == "rebase": cmd_rebase()
    else: die(f"nieznane polecenie: {' '.join(argv)} (freecode-tune --help)", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
