#!/usr/bin/env bash
# Learned rules in AGENTS.md — the only place where the model adds rules itself.
# Block between <!-- LEARNED:START --> and <!-- LEARNED:END -->, at most 10 lines, the oldest drops out.
#   agent-rule                 show the rules (numbered)
#   agent-rule add "TEXT"      add a rule (one line, up to 200 chars, with an example call)
#   agent-rule remove N        remove rule no. N
# Saves a backup to ~/oc-audyt/auto-kopie before every change (undo: ~/bin/backup-copy).
# Backward compatible: subcommands dodaj/usun and markers WYUCZONE:START/END also work.
set -u
FILE="$HOME/.config/opencode/AGENTS.md"
BACKUP_DIR="$HOME/oc-audyt/auto-kopie"
MAX=10

for tag in LEARNED WYUCZONE; do
  S="<!-- $tag:START -->"
  E="<!-- $tag:END -->"
  grep -qF "$S" "$FILE" && grep -qF "$E" "$FILE" && break
  S=""
done
[ -n "$S" ] || { echo "No <!-- LEARNED:START/END --> block markers in $FILE" >&2; exit 1; }

rules() { awk -v s="$S" -v e="$E" '$0==s{f=1;next} $0==e{f=0} f && /^- /' "$FILE"; }

save() {  # stdin = new rule lines
  mkdir -p "$BACKUP_DIR"
  local dst
  # one backup per second; never overwrite an earlier one
  while dst="$BACKUP_DIR/H__.config__opencode__AGENTS.md.$(date +%Y%m%d-%H%M%S)"; [ -e "$dst" ]; do sleep 1; done
  cp -p "$FILE" "$dst"
  local new tmp
  new=$(cat)
  tmp=$(mktemp)
  # ENVIRON, not -v: awk -v expands escapes (С -> Cyrillic letter, \d -> d)
  NEW_RULES="$new" awk -v s="$S" -v e="$E" '
    $0==s { print; if (ENVIRON["NEW_RULES"] != "") print ENVIRON["NEW_RULES"]; f=1; next }
    $0==e { f=0 }
    !f { print }' "$FILE" > "$tmp" && cat "$tmp" > "$FILE"
  rm -f "$tmp"
}

case "${1:-}" in
  "")
    n=$(rules | wc -l)
    echo "Learned rules: $n of $MAX"
    rules | nl -w2 -s'. '
    ;;
  add|dodaj)
    t="${2:-}"
    t=$(printf '%s' "$t" | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')
    [ -n "$t" ] || { echo "Give the rule text in quotes." >&2; exit 1; }
    [ "${#t}" -le 200 ] || { echo "Too long (${#t} chars, limit 200). Shorten it: what to do + one example." >&2; exit 1; }
    if rules | grep -qF -- "$t"; then echo "This rule already exists."; exit 0; fi
    { rules; echo "- $(date +%F) $t"; } | tail -n "$MAX" | save
    echo "Added. $(rules | wc -l) of $MAX rules, file $(wc -c < "$FILE") bytes. Undo: ~/bin/backup-copy AGENTS"
    ;;
  remove|usun)
    n="${2:-}"
    [[ "$n" =~ ^[0-9]+$ ]] || { echo "Give the rule number (see: agent-rule)." >&2; exit 1; }
    [ "$n" -ge 1 ] && [ "$n" -le "$(rules | wc -l)" ] || { echo "There is no rule no. $n." >&2; exit 1; }
    rules | sed "${n}d" | save
    echo "Removed rule no. $n."
    ;;
  *)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
